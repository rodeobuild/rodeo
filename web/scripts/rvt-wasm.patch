+/// body: at most [`PARTIAL_MAX_FAILED_FACES`] and at most
+/// [`PARTIAL_MAX_FAILED_SHARE`] of its decoded primitives.
+fn partial_failures_admissible(failed: &[&String], decoded: usize) -> bool {
+    let count = failed.len();
+    count <= PARTIAL_MAX_FAILED_FACES
+        && (count as f64) <= PARTIAL_MAX_FAILED_SHARE * decoded as f64
+        && failed.iter().all(|diagnostic| {
+            PARTIAL_FACE_FAILURES
+                .iter()
+                .any(|kind| diagnostic.contains(kind))
+        })
+}
