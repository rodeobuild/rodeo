+fn c_range_of(c: &Curve) -> [f64; 2] {
+    match c {
+        Curve::Line { range, .. }
+        | Curve::Arc { range, .. }
+        | Curve::Ellipse { range, .. }
+        | Curve::Hermite { range, .. } => *range,
+    }
+}
