+    #[test]
+    fn sweeps_a_square_along_a_bent_path_watertight() {
+        // a 2" square hanging below a path that climbs, then runs level
+        let s = 1.0 / 6.0;
+        let outline = [[s / 2.0, 0.0], [s / 2.0, -s], [-s / 2.0, -s], [-s / 2.0, 0.0]];
+        let path = [[0.0, 0.0, 0.0], [0.0, 3.0, 1.5], [0.0, 6.0, 1.5]];
+        let (vertices, triangles) = sweep(&path, &outline, 0.0).expect("swept");
+        assert_eq!(triangles.len(), 2 * 4 * 2 + 2 * 2);
+        // the top edge runs along the path and the rail hangs below it
+        let top = vertices.iter().map(|v| v[2]).fold(f64::NEG_INFINITY, f64::max);
+        assert!((top - 1.5).abs() < 1e-9);
+        assert!(vertices
