+/// Pass four's admission of a railing the railing rule refused: its mesh with
+/// its swept rails, kept where the whole fills its record box or reaches the
+/// top its records give it ([`reaches_railing_top`]).
+fn admit_railing(
+    railing: RefusedRailing,
+    rails: &crate::research::native_rails::RailingRails,
+    model: &mut IfcModel,
+    report: &mut SavedMeshReport,
+) {
+    let Some(sweeps) = &rails.sweeps else {
+        return;
+    };
+    let IfcEntity::BuildingElement {
+        location_feet: Some(origin),
+        rotation_radians,
+        extrusion,
+        solid_shape,
+        property_set: Some(set),
+        ..
+    } = &mut model.entities[railing.index]
+    else {
+        return;
+    };
+    let RefusedRailing {
+        mut vertices,
+        mut triangles,
+        ..
+    } = railing;
+    append_rails(&mut vertices, &mut triangles, sweeps, *origin, *rotation_radians);
+    let top = rails.top.map(|z| z - origin[2]);
+    if !(railing_mesh_fills_box(&vertices, extrusion.as_ref())
+        || reaches_railing_top(&vertices, extrusion.as_ref(), top))
+    {
+        return;
+    }
+    report.partial = report.partial.saturating_sub(1);
+    report.replaced += 1;
+    report.triangles += triangles.len();
+    *solid_shape = Some(SolidShape::TriangulatedFaceSet {
+        vertices_feet: vertices,
+        triangles,
+    });
+    for property in &mut set.properties {
+        if property.name == "BodySource" {
+            property.value = PropertyValue::Text(SAVED_MESH_BODY_SOURCE.into());
+        }
+    }
