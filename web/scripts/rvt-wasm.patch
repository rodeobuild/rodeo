+/// The rim rule before the seam tolerance: open edges merged by position to
+/// 1e-5 ft, with no T-junctions closed, lie within 0.05 ft of one plane.
+fn open_edges_form_one_rim_exact(primitives: &[Primitive]) -> bool {
+    let key = |p: [f64; 3]| p.map(|c| (c * 1e5).round() as i64);
+    let mut edges: BTreeMap<([i64; 3], [i64; 3]), (usize, [f64; 3])> = BTreeMap::new();
