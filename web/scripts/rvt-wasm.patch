+/// Swept rails, in world feet, added to a mesh in the frame of an element
+/// placed at `origin` and turned by `rotation` about the vertical.
+fn append_rails(
+    vertices: &mut Vec<[f64; 3]>,
+    triangles: &mut Vec<BrepTriangle>,
+    sweeps: &[crate::research::native_rails::RailMesh],
+    origin: [f64; 3],
+    rotation: Option<f64>,
+) {
+    let (sin, cos) = (-rotation.unwrap_or(0.0)).sin_cos();
+    for (points, faces) in sweeps {
+        let base = vertices.len() as u32;
+        vertices.extend(points.iter().map(|p| {
+            let (dx, dy) = (p[0] - origin[0], p[1] - origin[1]);
+            [dx * cos - dy * sin, dx * sin + dy * cos, p[2] - origin[2]]
+        }));
+        triangles.extend(faces.iter().map(|t| BrepTriangle(base + t[0], base + t[1], base + t[2])));
+    }
+}
