+//! A railing's continuous rails, swept from their native records, and the
+//! height its highest part reaches.
+//!
+//! Revit 2013 and later keep a railing's top rail and handrails as elements
+//! of their own (`TopRail`, `HandRail`), named in the railing's
+//! `m_continuousRailIds`, with no saved faces: a profile family
+//! (`m_profileData.m_profileFamSymId`, else its type's `m_profileId`; the
+//! family's `m_arrProfileLoops`) and the path it follows
+//! (`Path3dRailPathProvider.m_path3dId`, a `Path3d` whose `CurveLoop` holds
+//! `GLine`s and `GArc`s in world feet). A profile's loop may also hold
+//! `GEllipse`s, whose `m_xLen` and `m_yLen` are its semi-axes (Revit's record
+//! box over a railing with an elliptical rail ends that far from its path).
+//! On the sample projects a profile's loop runs from y = 0 down, or is
+//! centred on y = 0, and a top rail's path runs along the top of its
+//! railing's record box.
+//!
+//! The path is the rail's own: its extensions and its type's offset are in it
+//! already (on the sample projects a handrail type's offset puts its path
+//! that far from its railing's other rails, and Revit's record box ends at
+//! the path plus the profile). Its corners are not rounded in it: where the
+//! type joins rails with fillets (`m_defaultContinuousRailJoinType` 1 and its
+//! `m_filletRadius`), each corner here becomes an arc of that radius tangent
+//! to both segments, in their plane.
+//!
+//! The rails here are swept with the profile in each segment's normal plane,
+//! its y along world up there, mitred where segments meet and capped flat at
+//! the ends. An upright segment (a return, or an extension down to the floor)
+//! has no up of its own: there the profile's x stays across the run, as
+//! Revit's record boxes show, which says nothing of which way its y points,
+//! so only a profile centred on the path, the same turned half round, is
+//! swept along one. Only rails these records place exactly are swept: no
+//! profile offset, turn or flip, no joins set rail by rail, and a profile
+//! that is its own mirror image across its y axis (which side Revit lays a
+//! profile's x on is not confirmed).
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use serde_json::Value;
+
+use crate::RevitFile;
+use crate::native_document::{Options, extract_graphs};
+use crate::native_json::finite_triple;
+use crate::native_parameters::{GraphObject, ObjectGraph};
+
+/// A swept rail: vertices in world feet and triangles into them.
+pub type RailMesh = (Vec<[f64; 3]>, Vec<[u32; 3]>);
+
+/// A railing's rails as its records give them.
+#[derive(Debug, Default, Clone)]
+pub struct RailingRails {
+    /// Each of its continuous rails swept along its path. `None` where one
+    /// of them cannot be swept exactly.
+    pub sweeps: Option<Vec<RailMesh>>,
+    /// The height its highest part reaches, world feet: the top of its path
+    /// (the most of its symbol's `RailingCurveLoopData.m_heights`) plus its
+    /// type's highest rail, where every baluster and post of the type stops
+    /// at one of those rails. `None` where the records do not say.
+    pub top: Option<f64>,
+}
+
+/// How far, in feet, a curve of a path or profile may start from where the
+/// one before it ends.
+const JOIN_TOLERANCE_FEET: f64 = 1e-3;
+
+/// How far a sampled arc's chords may stray from it, feet.
+const ARC_CHORD_FEET: f64 = 0.002;
+
+/// An element id field, `{"m_id":{"m_id64":N}}`, or `{"m_id":{"m_id":N}}`
+/// before Revit 2023. `None` for a missing or unset (negative) id.
+fn element_id(v: &Value, name: &str) -> Option<u64> {
+    let id = v.get(name)?.get("m_id")?;
+    id.get("m_id64").or_else(|| id.get("m_id"))?.as_u64()
+}
+
+/// Every element id a value names, anywhere inside it.
+fn ids_in(v: &Value, out: &mut BTreeSet<u64>) {
+    match v {
+        Value::Object(m) => {
+            if let Some(id) = m
+                .get("m_id")
+                .and_then(|x| x.get("m_id64").or_else(|| x.get("m_id")))
+                .and_then(Value::as_u64)
+            {
+                out.insert(id);
+            }
+            for x in m.values() {
+                ids_in(x, out);
+            }
+        }
+        Value::Array(a) => a.iter().for_each(|x| ids_in(x, out)),
+        _ => {}
+    }
+}
+
+fn number(v: &Value, name: &str) -> Option<f64> {
+    v.get(name)?.as_f64().filter(|x| x.is_finite())
+}
+
+fn point(v: &Value, name: &str) -> Option<[f64; 3]> {
+    finite_triple(v.get(name)?)
+}
+
+/// The graphs of the records `ids` names, keyed by element id.
+fn graphs(rf: &mut RevitFile, ids: &BTreeSet<u64>) -> anyhow::Result<BTreeMap<u64, ObjectGraph>> {
+    let mut out = BTreeMap::new();
+    if ids.is_empty() {
+        return Ok(out);
+    }
+    let options = Options {
+        selected_ids: ids.clone(),
+        ..Options::default()
+    };
+    extract_graphs(rf, &options, |record| {
+        if let Some(graph) = record.graph {
+            out.insert(record.identity.element_id, graph);
+        }
+        Ok(())
+    })?;
+    Ok(out)
+}
+
+fn first<'a>(graph: &'a ObjectGraph, class: &str) -> Option<(usize, &'a GraphObject)> {
+    graph
+        .objects
+        .iter()
+        .enumerate()
+        .find(|(_, o)| o.class_name == class)
+}
+
+/// The points of one curve from its start to its end: a `GLine`'s two ends,
+/// a `GArc` or `GEllipse` sampled finely enough to stay within
+/// [`ARC_CHORD_FEET`] of it. `None` for any other curve.
+fn curve_points(curve: &GraphObject) -> Option<Vec<[f64; 3]>> {
+    let params = curve.fields.get("m_endParams")?.as_array()?;
+    let [t0, t1] = params.as_slice() else {
+        return None;
+    };
+    let (t0, t1) = (t0.as_f64()?, t1.as_f64()?);
+    if !(t0.is_finite() && t1.is_finite()) {
+        return None;
+    }
+    match curve.class_name.as_str() {
+        "GLine" => {
+            let origin = point(&curve.fields, "m_origin")?;
+            let direction = point(&curve.fields, "m_dirVec")?;
+            Some(
+                [t0, t1]
+                    .iter()
+                    .map(|t| [0, 1, 2].map(|i| origin[i] + direction[i] * t))
+                    .collect(),
+            )
+        }
+        "GArc" => {
+            let centre = point(&curve.fields, "m_center")?;
+            let x = point(&curve.fields, "m_xVec")?;
+            let y = point(&curve.fields, "m_yVec")?;
+            let radius = number(&curve.fields, "m_radius")?;
+            if radius <= 0.0 {
+                return None;
+            }
+            let count = arc_steps(radius, t1 - t0);
+            Some(
+                (0..=count)
+                    .map(|k| {
+                        let t = t0 + (t1 - t0) * k as f64 / count as f64;
+                        [0, 1, 2].map(|i| centre[i] + radius * (t.cos() * x[i] + t.sin() * y[i]))
+                    })
+                    .collect(),
+            )
+        }
+        "GEllipse" => {
+            let centre = point(&curve.fields, "m_center")?;
+            let x = point(&curve.fields, "m_xVec")?;
+            let y = point(&curve.fields, "m_yVec")?;
+            let (a, b) = (number(&curve.fields, "m_xLen")?, number(&curve.fields, "m_yLen")?);
+            if a <= 0.0 || b <= 0.0 {
+                return None;
+            }
+            // no chord of an ellipse strays further than one of a circle of
+            // its larger semi-axis sampled at the same parameter steps
+            let count = arc_steps(a.max(b), t1 - t0);
+            Some(
+                (0..=count)
+                    .map(|k| {
+                        let t = t0 + (t1 - t0) * k as f64 / count as f64;
+                        [0, 1, 2].map(|i| centre[i] + a * t.cos() * x[i] + b * t.sin() * y[i])
+                    })
+                    .collect(),
+            )
+        }
+        _ => None,
+    }
+}
+
+fn distance(a: [f64; 3], b: [f64; 3]) -> f64 {
+    (0..3).map(|k| (a[k] - b[k]).powi(2)).sum::<f64>().sqrt()
+}
+
+/// How many chords keep an arc of `radius` through `angle` radians within
+/// [`ARC_CHORD_FEET`] of it.
+fn arc_steps(radius: f64, angle: f64) -> usize {
+    let step = (2.0 * (1.0 - (ARC_CHORD_FEET / radius).min(1.0)).acos())
+        .min(std::f64::consts::PI / 24.0);
+    (angle.abs() / step).ceil().clamp(1.0, 512.0) as usize
+}
+
+/// The curves of the `CurveLoop` at `loop_value` (a pointer from object
+/// `source`) chained end to start into one run of points, a curve turned
+/// round where it runs the other way, with whether the loop is open.
+fn loop_points(graph: &ObjectGraph, source: usize, loop_value: &Value) -> Option<(Vec<[f64; 3]>, bool)> {
+    let index = crate::native_saved_mesh::pointer(graph, source, loop_value).ok()??;
+    let curve_loop = graph.objects.get(index)?;
+    if curve_loop.class_name != "CurveLoop" {
+        return None;
+    }
+    let open = curve_loop.fields.get("m_open")?.as_bool()?;
+    let near = |a: [f64; 3], b: [f64; 3]| distance(a, b) <= JOIN_TOLERANCE_FEET;
+    let mut out: Vec<[f64; 3]> = Vec::new();
+    for (i, curve) in curve_loop.fields.get("m_curves")?.as_array()?.iter().enumerate() {
+        let target = crate::native_saved_mesh::pointer(graph, index, curve).ok()??;
+        let mut points = curve_points(graph.objects.get(target)?)?;
+        if i > 0 {
+            let end = *out.last()?;
+            if !near(end, points[0]) {
+                if near(end, points[points.len() - 1]) {
+                    points.reverse();
+                } else if i == 1
+                    && (near(out[0], points[0]) || near(out[0], points[points.len() - 1]))
+                {
+                    // the first curve runs the other way
+                    out.reverse();
+                    if !near(out[out.len() - 1], points[0]) {
+                        points.reverse();
+                    }
+                } else {
+                    return None;
+                }
+            }
+            out.extend(points.into_iter().skip(1));
+        } else {
+            out = points;
+        }
+    }
+    (out.len() >= 2).then_some((out, open))
+}
+
+/// A profile family's outline in its own x-y plane: the one closed loop of
+/// its `m_arrProfileLoops`, lying at z = 0.
+fn profile_outline(graph: &ObjectGraph) -> Option<Vec<[f64; 2]>> {
+    let (index, symbol) = first(graph, "FamilySymbol")?;
+    let loops = symbol.fields.get("m_arrProfileLoops")?.as_array()?;
+    let [only] = loops.as_slice() else {
+        return None;
+    };
+    let (mut points, open) = loop_points(graph, index, only)?;
+    if open || points.iter().any(|p| p[2].abs() > 1e-6) {
+        return None;
+    }
+    if distance(points[0], points[points.len() - 1]) <= JOIN_TOLERANCE_FEET {
+        points.pop();
+    }
+    (points.len() >= 3).then(|| points.iter().map(|p| [p[0], p[1]]).collect())
+}
+
+/// Whether `outline` is its own mirror image across its y axis, to 1e-4 ft.
+fn mirror_symmetric(outline: &[[f64; 2]]) -> bool {
+    outline.iter().all(|p| {
+        outline
+            .iter()
+            .any(|q| (q[0] + p[0]).abs() <= 1e-4 && (q[1] - p[1]).abs() <= 1e-4)
+    })
+}
+
+/// Whether `outline` is the same turned half round about the path, to 1e-4 ft.
+fn centred(outline: &[[f64; 2]]) -> bool {
+    outline.iter().all(|p| {
+        outline
+            .iter()
+            .any(|q| (q[0] + p[0]).abs() <= 1e-4 && (q[1] + p[1]).abs() <= 1e-4)
+    })
+}
+
+/// `path` with each corner rounded by an arc of `radius` tangent to the two
+/// segments that meet there, in their plane, sampled within
+/// [`ARC_CHORD_FEET`]. `None` where a segment is too short for the arcs at
+/// its two ends.
+fn filleted(path: &[[f64; 3]], radius: f64) -> Option<Vec<[f64; 3]>> {
+    let n = path.len();
+    if radius <= 0.0 || n < 3 {
+        return Some(path.to_vec());
+    }
+    let directions: Vec<[f64; 3]> = (0..n - 1)
+        .map(|j| unit(sub(path[j + 1], path[j])))
+        .collect::<Option<_>>()?;
+    // the turn at each inner corner and how far its arc reaches along each
+    // segment from it
+    let turns: Vec<f64> = (1..n - 1)
+        .map(|j| dot(directions[j - 1], directions[j]).clamp(-1.0, 1.0).acos())
+        .collect();
+    let reach: Vec<f64> = turns
+        .iter()
+        .map(|&turn| if turn < 1e-6 { 0.0 } else { radius * (turn / 2.0).tan() })
+        .collect();
+    for j in 0..n - 1 {
+        let at_start = if j > 0 { reach[j - 1] } else { 0.0 };
+        let at_end = if j + 2 < n { reach[j] } else { 0.0 };
+        let used = at_start + at_end;
+        if !used.is_finite() || used > distance(path[j], path[j + 1]) + 1e-9 {
+            return None;
+        }
+    }
+    let mut out = vec![path[0]];
+    for j in 1..n - 1 {
+        let (turn, d) = (turns[j - 1], reach[j - 1]);
+        if d == 0.0 {
+            out.push(path[j]);
+            continue;
+        }
+        let (a, b) = (directions[j - 1], directions[j]);
+        let start = [0, 1, 2].map(|k| path[j][k] - a[k] * d);
+        let end = [0, 1, 2].map(|k| path[j][k] + b[k] * d);
+        // the centre lies on the corner's bisector, inside it
+        let inward = unit(sub(b, a))?;
+        let centre = [0, 1, 2].map(|k| path[j][k] + inward[k] * radius / (turn / 2.0).cos());
+        let (from, to) = (sub(start, centre), sub(end, centre));
+        let count = arc_steps(radius, turn);
+        out.extend((0..=count).map(|k| {
+            let s = k as f64 / count as f64;
+            let (p, q) = (((1.0 - s) * turn).sin() / turn.sin(), (s * turn).sin() / turn.sin());
+            [0, 1, 2].map(|i| centre[i] + p * from[i] + q * to[i])
+        }));
+    }
+    out.push(path[n - 1]);
+    Some(out)
+}
+
+fn sub(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+
+fn dot(a: [f64; 3], b: [f64; 3]) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+fn cross3(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+    [
+        a[1] * b[2] - a[2] * b[1],
+        a[2] * b[0] - a[0] * b[2],
+        a[0] * b[1] - a[1] * b[0],
+    ]
+}
+
+fn unit(a: [f64; 3]) -> Option<[f64; 3]> {
+    let length = dot(a, a).sqrt();
+    (length > 1e-9).then(|| a.map(|c| c / length))
+}
+
+/// `outline` swept along `path`, its corners first rounded to `fillet` feet
+/// where that is above zero ([`filleted`]): in each segment's normal plane,
+/// its y along world up there and its x to the right looking along the
+/// path, mitred where segments meet and capped flat at both ends. Along an
+/// upright segment its x stays across the run, as on the segments either
+/// side, which must run in one upright plane with it; only an outline
+/// centred on the path ([`centred`]) is swept along one. `None` for a path
+/// that turns back on itself or has any other upright segment, and for an
+/// outline that does not cut into triangles.
+pub fn sweep(path: &[[f64; 3]], outline: &[[f64; 2]], fillet: f64) -> Option<RailMesh> {
+    let mut path: Vec<[f64; 3]> = path.to_vec();
+    path.dedup_by(|b, a| distance(*a, *b) <= 1e-6);
+    let mut path = filleted(&path, fillet)?;
+    path.dedup_by(|b, a| distance(*a, *b) <= 1e-6);
+    let n = path.len();
+    if n < 2 {
+        return None;
+    }
+    let ring: Vec<(f64, f64)> = outline.iter().map(|p| (p[0], p[1])).collect();
+    let section = crate::ifc::body_geometry::section(&ring, &[])?;
+    let [outer] = section.rings.as_slice() else {
+        return None;
+    };
+    // `section` falls back to the bounding rectangle of a profile it cannot
+    // cut into triangles; that is not the profile.
+    let area = |r: &[(f64, f64)]| {
+        (0..r.len())
+            .map(|i| r[i].0 * r[(i + 1) % r.len()].1 - r[(i + 1) % r.len()].0 * r[i].1)
+            .sum::<f64>()
+            .abs()
+            / 2.0
+    };
+    if (area(outer) - area(&ring)).abs() > 1e-9_f64.max(area(&ring) * 1e-6) {
+        return None;
+    }
+    let tangents: Vec<[f64; 3]> = (0..n - 1)
+        .map(|j| unit(sub(path[j + 1], path[j])))
+        .collect::<Option<_>>()?;
+    let up = [0.0, 0.0, 1.0];
+    // an upright segment has no up of its own
+    let own: Vec<Option<([f64; 3], [f64; 3])>> = tangents
+        .iter()
+        .map(|&t| {
+            let flat = sub(up, t.map(|c| c * dot(up, t)));
+            if dot(flat, flat) < 1e-6 {
+                return None;
+            }
+            let y = unit(flat)?;
+            Some((cross3(t, y), y))
+        })
+        .collect();
+    let mut frames: Vec<([f64; 3], [f64; 3])> = Vec::with_capacity(n - 1);
+    for (j, frame) in own.iter().enumerate() {
+        if let Some(frame) = frame {
+            frames.push(*frame);
+            continue;
+        }
+        if !centred(outline) {
+            return None;
+        }
+        // across the run, as on the nearest segments either side that have
+        // an up, which must agree
+        let before = own[..j].iter().rev().flatten().next().map(|f| f.0);
+        let after = own[j + 1..].iter().flatten().next().map(|f| f.0);
+        let x = match (before, after) {
+            (Some(a), Some(b)) if dot(a, b).abs() >= 1.0 - 1e-6 => a,
+            (Some(a), None) | (None, Some(a)) => a,
+            _ => return None,
+        };
+        frames.push((x, cross3(x, tangents[j])));
+    }
+    // Each segment's frame is the one before it mirrored in the plane of
+    // their joint, so the section is the same either side of the mitre. Where
+    // it comes out turned half round instead (round an upright return), it
+    // is turned to match, which only an outline centred on the path allows.
+    for j in 1..n - 1 {
+        let normal = unit([0, 1, 2].map(|k| tangents[j - 1][k] + tangents[j][k]))?;
+        let x = frames[j - 1].0;
+        let mirrored = sub(x, normal.map(|c| 2.0 * dot(x, normal) * c));
+        if dot(mirrored, frames[j].0) < 0.0 {
+            if !centred(outline) {
+                return None;
+            }
+            let (x, y) = frames[j];
+            frames[j] = (x.map(|c| -c), y.map(|c| -c));
+        }
+    }
+    let place = |p: [f64; 3], (x, y): ([f64; 3], [f64; 3]), u: f64, v: f64| {
+        [0, 1, 2].map(|k| p[k] + x[k] * u + y[k] * v)
+    };
+    let mut vertices: Vec<[f64; 3]> =
+        Vec::with_capacity(n * outer.len() + 2 * section.cap_points.len());
+    for j in 0..n {
+        let segment = j.saturating_sub(1).min(n - 2);
+        let (t, f) = (tangents[segment], frames[segment]);
+        // where two segments meet, the section lies in the plane halfway
+        // between their normal planes, reached along the segment before
+        let mitre = if j > 0 && j < n - 1 {
+            let normal = unit([0, 1, 2].map(|k| tangents[j - 1][k] + tangents[j][k]))?;
+            if dot(t, normal) < 1e-3 {
+                return None;
+            }
+            Some(normal)
+        } else {
+            None
+        };
+        for &(u, v) in outer {
+            let q = place(path[j], f, u, v);
+            vertices.push(match mitre {
+                Some(normal) => {
+                    let s = dot(sub(path[j], q), normal) / dot(t, normal);
+                    [0, 1, 2].map(|k| q[k] + s * t[k])
+                }
+                None => q,
+            });
+        }
+    }
+    let m = outer.len() as u32;
+    let mut sides = Vec::with_capacity((n - 1) * outer.len() * 2);
+    for j in 0..(n - 1) as u32 {
+        for k in 0..m {
+            let (a, b) = (j * m + k, j * m + (k + 1) % m);
+            let (c, d) = (a + m, b + m);
+            sides.push([a, b, d]);
+            sides.push([a, d, c]);
+        }
+    }
+    // the sides face out, away from the middle of the outline, as the first
+    // one is made to
+    let middle = (0..m as usize)
+        .fold([0.0; 3], |sum, i| [0, 1, 2].map(|k| sum[k] + vertices[i][k] / m as f64));
+    let [a, b, c] = sides[0].map(|i| vertices[i as usize]);
+    let flip = dot(cross3(sub(b, a), sub(c, a)), sub(a, middle)) < 0.0;
+    let mut triangles: Vec<[u32; 3]> = sides
+        .into_iter()
+        .map(|[a, b, c]| if flip { [a, c, b] } else { [a, b, c] })
+        .collect();
+    for (p, f, facing) in [
+        (path[0], frames[0], tangents[0].map(|c| -c)),
+        (path[n - 1], frames[n - 2], tangents[n - 2]),
+    ] {
+        let base = vertices.len() as u32;
+        vertices.extend(section.cap_points.iter().map(|&(u, v)| place(p, f, u, v)));
+        for t in &section.cap_triangles {
+            let [a, b, c] = t.map(|i| base + i);
+            let [pa, pb, pc] = [a, b, c].map(|i| vertices[i as usize]);
+            let normal = cross3(sub(pb, pa), sub(pc, pa));
+            triangles.push(if dot(normal, facing) < 0.0 { [a, c, b] } else { [a, b, c] });
+        }
+    }
+    Some((vertices, triangles))
+}
+
+/// A continuous rail's record, as read for its sweep.
+struct Rail {
+    path: u64,
+    profile: Option<u64>,
+    rail_type: Option<u64>,
+}
+
+/// The rail of a `TopRail` or `HandRail` record, `None` where its profile is
+/// offset, turned or flipped.
+fn rail_of(graph: &ObjectGraph) -> Option<Rail> {
+    let rail = graph
+        .objects
+        .first()
+        .filter(|o| o.class_name == "TopRail" || o.class_name == "HandRail")?;
+    let data = rail.fields.get("m_profileData")?;
+    let zero = |name: &str| number(data, name) == Some(0.0);
+    if !(zero("m_angle") && zero("m_xOffset") && zero("m_yOffset"))
+        || data.get("m_flippedX")?.as_bool()?
+    {
+        return None;
+    }
+    // joins set rail by rail, rather than by its type, are not read
+    if first(graph, "ContinuousRailJoinInfoCell").is_some_and(|(_, cell)| {
+        cell.fields
+            .get("m_joinInfoItems")
+            .and_then(Value::as_array)
+            .is_none_or(|items| !items.is_empty())
+    }) {
+        return None;
+    }
+    let (_, provider) = first(graph, "Path3dRailPathProvider")?;
+    Some(Rail {
+        path: element_id(&provider.fields, "m_path3dId")?,
+        profile: element_id(data, "m_profileFamSymId"),
+        rail_type: element_id(&rail.fields, "m_typeId"),
+    })
+}
+
+/// A railing type's (`StairsRailingAttr`) highest rail above the railing's
+/// path, feet, where each baluster and post family of the type stops at or
+/// below one of its rails (`m_topReferenceId` naming one, `m_topOffset` not
+/// above it).
+fn highest_rail(graph: &ObjectGraph) -> Option<f64> {
+    let (_, attr) = first(graph, "StairsRailingAttr")?;
+    let mut highest = f64::NEG_INFINITY;
+    let mut rails = BTreeSet::new();
+    for o in graph.objects.iter().filter(|o| o.class_name == "NonContinuousRailInfo") {
+        highest = highest.max(number(&o.fields, "m_height")?);
+        rails.insert(o.fields.get("m_railId")?.as_i64()?);
+    }
+    if element_id(&attr.fields, "m_topRailTypeId").is_some_and(|id| id > 0) {
+        highest = highest.max(number(&attr.fields, "m_topRailHeight")?);
+    }
+    let stops_at_a_rail = graph
+        .objects
+        .iter()
+        .filter(|o| o.class_name == "BalusterInfo")
+        .all(|o| {
+            element_id(&o.fields, "m_balusterTypeId").is_none_or(|id| id == 0)
+                || o.fields
+                    .get("m_topReferenceId")
+                    .and_then(Value::as_i64)
+                    .is_some_and(|r| rails.contains(&r))
+                    && number(&o.fields, "m_topOffset").is_some_and(|x| x <= 0.0)
+        });
+    (highest.is_finite() && stops_at_a_rail).then_some(highest)
+}
+
+/// The top of a railing's path, world feet: the most of its symbol's
+/// (`BaseRailingSym`) `RailingCurveLoopData.m_heights`.
+fn path_top(graph: &ObjectGraph) -> Option<f64> {
+    graph
+        .objects
+        .iter()
+        .filter(|o| o.class_name == "RailingCurveLoopData")
+        .flat_map(|o| {
+            o.fields
+                .get("m_heights")
+                .and_then(Value::as_array)
+                .into_iter()
+                .flatten()
+                .filter_map(Value::as_f64)
+        })
+        .filter(|h| h.is_finite())
+        .reduce(f64::max)
+}
+
+/// The rails of each railing (`BaseRailing`) in `railings`, keyed by its id.
+pub fn railing_rails(
+    rf: &mut RevitFile,
+    railings: &BTreeSet<u64>,
+) -> anyhow::Result<BTreeMap<u64, RailingRails>> {
+    struct Railing {
+        rails: BTreeSet<u64>,
+        railing_type: Option<u64>,
+        symbol: Option<u64>,
+    }
+    let mut found: BTreeMap<u64, Railing> = BTreeMap::new();
+    for (id, graph) in graphs(rf, railings)? {
+        let Some(railing) = graph.objects.first().filter(|o| o.class_name == "BaseRailing") else {
+            continue;
+        };
+        let mut rails = BTreeSet::new();
+        if let Some(list) = railing.fields.get("m_continuousRailIds") {
+            ids_in(list, &mut rails);
+        }
+        rails.retain(|id| *id > 0);
+        found.insert(
+            id,
+            Railing {
+                rails,
+                railing_type: element_id(&railing.fields, "m_stairsRailingAttrId"),
+                symbol: element_id(&railing.fields, "m_baseRailingSymbolId"),
+            },
+        );
+    }
+    let wanted: BTreeSet<u64> = found
+        .values()
+        .flat_map(|r| r.rails.iter().copied().chain(r.railing_type).chain(r.symbol))
+        .filter(|id| *id > 0)
+        .collect();
+    let second = graphs(rf, &wanted)?;
+    let rails: BTreeMap<u64, Option<Rail>> = found
+        .values()
+        .flat_map(|r| r.rails.iter())
+        .map(|id| (*id, second.get(id).and_then(rail_of)))
+        .collect();
+    let wanted: BTreeSet<u64> = rails
+        .values()
+        .flatten()
+        .flat_map(|r| [Some(r.path), r.profile, r.rail_type])
+        .flatten()
+        .filter(|id| *id > 0)
+        .collect();
+    let mut third = graphs(rf, &wanted)?;
+    // a rail that takes its type's profile reads that profile too
+    let type_profiles: BTreeSet<u64> = rails
+        .values()
+        .flatten()
+        .filter(|r| r.profile.is_none_or(|id| id == 0))
+        .filter_map(|r| r.rail_type.and_then(|t| third.get(&t)))
+        .filter_map(|g| g.objects.first().and_then(|o| element_id(&o.fields, "m_profileId")))
+        .filter(|id| *id > 0 && !third.contains_key(id))
+        .collect();
+    third.extend(graphs(rf, &type_profiles)?);
+    let swept = |rail: &Rail| -> Option<RailMesh> {
+        let type_fields = &third.get(&rail.rail_type?)?.objects.first()?.fields;
+        // the type's offset and extensions are in the path already; its
+        // joins are mitred (0) or filleted (1) to its fillet radius
+        let fillet = match type_fields.get("m_defaultContinuousRailJoinType")?.as_i64()? {
+            0 => 0.0,
+            1 => number(type_fields, "m_filletRadius").filter(|r| *r >= 0.0)?,
+            _ => return None,
+        };
+        let profile = rail
+            .profile
+            .filter(|id| *id > 0)
+            .or_else(|| element_id(type_fields, "m_profileId"))?;
+        let outline = profile_outline(third.get(&profile)?)?;
+        if !mirror_symmetric(&outline) {
+            return None;
+        }
+        let path_graph = third.get(&rail.path)?;
+        let (index, path) = first(path_graph, "Path3d")?;
+        let loops = path.fields.get("m_curveLoops")?.as_array()?;
+        let [only] = loops.as_slice() else {
+            return None;
+        };
+        let (points, open) = loop_points(path_graph, index, only)?;
+        if !open {
+            return None;
+        }
+        sweep(&points, &outline, fillet)
+    };
+    Ok(found
+        .into_iter()
+        .map(|(id, railing)| {
+            let sweeps = railing
+                .rails
+                .iter()
+                .map(|r| rails.get(r)?.as_ref().and_then(&swept))
+                .collect::<Option<Vec<_>>>();
+            let top = railing
+                .symbol
+                .and_then(|s| second.get(&s))
+                .and_then(path_top)
+                .zip(railing.railing_type.and_then(|t| second.get(&t)).and_then(highest_rail))
+                .map(|(path, rail)| path + rail);
+            (id, RailingRails { sweeps, top })
+        })
+        .collect())
+}
