+/// Whether face `fi` is decoded by a curved-profile path this module adds
+/// (see [`is_new_path`]); its element is then checked as a whole.
+pub(crate) fn is_new_path_face(g: &ObjectGraph, fi: usize) -> Result<bool> {
+    use crate::native_saved_mesh::pointer;
+    let f = &g.objects[fi];
+    let Some(si) = pointer(g, fi, &f.fields["m_pSurf"])? else {
+        return Ok(false);
+    };
+    if !matches!(g.objects[si].class_name.as_str(), "RuledSurf" | "SurfRev") {
+        return Ok(false);
+    }
+    Ok(is_new_path(&ParametricSurface::read(g, si)?))
+}
