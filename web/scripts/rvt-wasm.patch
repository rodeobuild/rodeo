+}
+
+/// The distance from `p` to the triangle `c`.
+fn point_triangle_distance(p: [f64; 3], c: [[f64; 3]; 3]) -> f64 {
+    let n = cross3(sub3(c[1], c[0]), sub3(c[2], c[0]));
+    let nn = dot3(n, n);
+    if nn > 1e-24 {
+        let h = dot3(sub3(p, c[0]), n) / nn;
+        let q: [f64; 3] = std::array::from_fn(|k| p[k] - h * n[k]);
+        let inside = (0..3).all(|k| {
+            dot3(cross3(sub3(c[(k + 1) % 3], c[k]), sub3(q, c[k])), n) >= 0.
+        });
+        if inside {
+            return (h * h * nn).sqrt();
+        }
+    }
+    (0..3)
+        .map(|k| segment_distance3(p, c[k], c[(k + 1) % 3]))
+        .fold(f64::INFINITY, f64::min)
+}
+
+/// Whether the open edge `i` lies along partner open edges within [`SEAM`] at
+/// its two ends and its middle. A partner is an open edge of another face, or
+/// of another chain, of the same shell.
+fn lies_along_partner(
+    i: usize,
+    open: &[OpenEdge],
+    chain_of: &[usize],
+    boxes: &[([f64; 3], [f64; 3])],
+) -> bool {
+    let e = open[i];
+    let middle: [f64; 3] = std::array::from_fn(|c| (e.a[c] + e.b[c]) * 0.5);
+    [e.a, middle, e.b].into_iter().all(|p| {
+        (0..open.len()).any(|j| {
+            let (lo, hi) = boxes[j];
+            let f = open[j];
+            j != i
+                && (f.face != e.face || chain_of[j] != chain_of[i])
+                && (0..3).all(|c| p[c] >= lo[c] && p[c] <= hi[c])
+                && segment_distance3(p, f.a, f.b) <= SEAM
+        })
+    })
+}
