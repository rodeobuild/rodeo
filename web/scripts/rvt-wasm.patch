+/// A flat primitive's plane, as its unit normal (largest component positive)
+/// and offset, and a point inside it (the centre of its largest triangle).
+type FlatPlane = ([f64; 3], f64, [f64; 3]);
+
+fn sub3(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+    std::array::from_fn(|k| a[k] - b[k])
+}
+
+fn dot3(a: [f64; 3], b: [f64; 3]) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+fn cross3(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+
+fn corners(p: &Primitive, t: &[u32; 3]) -> Option<[[f64; 3]; 3]> {
+    Some([
+        *p.vertices.get(t[0] as usize)?,
+        *p.vertices.get(t[1] as usize)?,
+        *p.vertices.get(t[2] as usize)?,
+    ])
+}
+
+/// Each primitive's plane where all its vertices lie within [`VISUAL`] of it.
+fn flat_planes(primitives: &[Primitive]) -> Vec<Option<FlatPlane>> {
+    primitives
+        .iter()
+        .map(|p| {
+            let (mut best, mut area) = (None, 0.);
+            for t in &p.triangles {
+                let c = corners(p, t)?;
+                let n = cross3(sub3(c[1], c[0]), sub3(c[2], c[0]));
+                let a = dot3(n, n).sqrt();
+                if a > area {
+                    area = a;
+                    best = Some((n, c));
+                }
+            }
+            let (n, c) = best?;
+            if area < 1e-12 {
+                return None;
+            }
+            let mut n = n.map(|x| x / area);
+            let big = (0..3).max_by(|&a, &b| n[a].abs().total_cmp(&n[b].abs()))?;
+            if n[big] < 0. {
+                n = n.map(|x| -x);
+            }
+            let d = dot3(n, c[0]);
+            let flat = p.vertices.iter().all(|&v| (dot3(n, v) - d).abs() <= VISUAL);
+            let inside = std::array::from_fn(|k| (c[0][k] + c[1][k] + c[2][k]) / 3.);
+            flat.then_some((n, d, inside))
+        })
+        .collect()
+}
+
+/// Which of the `candidates` (flat faces meeting no face at an angle to them)
+/// are sheets lying on another face of the shell: every vertex within
+/// [`VISUAL`] of that face's plane, and a point inside the sheet inside one
+/// of its triangles. Such a sheet (a tread outline over its tread, turned a
+/// little) closes nothing, and its outline is not a hole in the shell.
+fn overlay_sheets(
+    primitives: &[Primitive],
+    candidates: &[bool],
+    planes: &[Option<FlatPlane>],
+) -> Vec<bool> {
+    (0..primitives.len())
+        .map(|i| {
+            let Some((n, d, inside)) = planes[i].filter(|_| candidates[i]) else {
+                return false;
+            };
+            (0..primitives.len()).any(|j| {
+                let Some((m, e, _)) = planes[j] else {
+                    return false;
+                };
+                if j == i || dot3(n, m) < 1. - 1e-6 || (d - e).abs() > VISUAL {
+                    return false;
+                }
+                let other = &primitives[j];
+                primitives[i].vertices.iter().all(|&v| (dot3(m, v) - e).abs() <= VISUAL)
+                    && other.triangles.iter().any(|t| {
+                        corners(other, t).is_some_and(|c| point_triangle_distance(inside, c) <= 1e-9)
+                    })
+            })
+        })
+        .collect()
+}
+
+/// Whether open edge `e` of a flat face lies on another face in the same
+/// plane: its ends and middle within [`SEAM`] of that face's triangles, and
+/// no open edge of that face within [`SEAM`] of its middle (so two faces open
+/// at the same place do not cover each other).
+fn covered_by_coplanar_face(
+    e: &OpenEdge,
+    primitives: &[Primitive],
+    planes: &[Option<FlatPlane>],
+    open: &[OpenEdge],
+) -> bool {
+    let Some((n, d, _)) = planes[e.face] else {
+        return false;
+    };
+    let middle: [f64; 3] = std::array::from_fn(|c| (e.a[c] + e.b[c]) * 0.5);
+    (0..primitives.len()).any(|j| {
+        let Some((m, f, _)) = planes[j] else {
+            return false;
+        };
+        if j == e.face || dot3(n, m) < 1. - 1e-6 || (d - f).abs() > VISUAL {
+            return false;
+        }
+        let other = &primitives[j];
+        [e.a, middle, e.b].into_iter().all(|p| {
+            other.triangles.iter().any(|t| {
+                corners(other, t).is_some_and(|c| point_triangle_distance(p, c) <= SEAM)
+            })
+        }) && open
+            .iter()
+            .filter(|o| o.face == j)
+            .all(|o| segment_distance3(middle, o.a, o.b) > SEAM)
