+    index: usize,
+    rails: &crate::research::native_rails::RailingRails,
+    model: &mut IfcModel,
+    report: &mut SavedMeshReport,
+) {
+    let Some(sweeps) = rails.sweeps.as_ref().filter(|s| !s.is_empty()) else {
+        return;
