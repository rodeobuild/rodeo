+/// has two failures the same rules decode: a multi-loop cylinder, and a
+/// trimmed face whose ring lies outside its outer loop (an island under those
+/// rules). Only these are decoded again; no admitted body in the corpus
+/// needed a surface-pointer candidate.
+fn round5_candidate(diagnostics: &[String], turned: bool) -> bool {
+    let mut kinds = vec![
+        "disconnected UV boundary",
+        "missing surface pointer target",
+        // Trimmed faces the CDT refuses, and trimmed ruled faces whose shared
+        // edges disagree before the trim is drawn.
+        "trimmed face needs too many refinement points",
+        "trimmed face needs a finer triangulation",
+        "trimmed ruled face: shared edge disagrees",
+        // A trim edge the triangulation cannot recover by flips alone; the
+        // retry inserts it by retriangulating its cavity.
+        "trim boundary not recoverable",
+        // A curved shell refused for open edges: under the same rules its
+        // ruled bands are cut along their twist only, and flat sheets lying
+        // on another face are left out of its edges.
+        "curved-profile shell leaves open edges off one rim",
+    ];
+    if turned {
+        kinds.push("multiple cylinder trim loops unsupported");
+        kinds.push("trim hole outside its outer loop");
+    }
+    diagnostics
+        .iter()
+        .any(|d| kinds.iter().any(|kind| d.contains(kind)))
+}
+
+/// Whether the retry left a curved shell refused for open edges: the one
+/// refusal the band rules (pass three) can change.
+fn band_candidate(diagnostics: &[String]) -> bool {
+    diagnostics
+        .iter()
+        .any(|d| d.contains("curved-profile shell leaves open edges off one rim"))
+}
+
+/// Adds `own`'s counts to `report`.
+fn absorb(report: &mut SavedMeshReport, own: &SavedMeshReport) {
+    report.replaced += own.replaced;
+    report.partial += own.partial;
+    report.partial_admitted += own.partial_admitted;
+    report.triangles += own.triangles;
+}
+
+/// The admission of one element's saved graphics as its body: a decoded body
+/// that passes every gate replaces the element's box. Counts go to `report`.
+fn admit_element(
+    element: &SavedElement,
+    index: usize,
+    model: &mut IfcModel,
+    turned: bool,
+    report: &mut SavedMeshReport,
+    curves: &dyn Fn(f64) -> Option<CurveReading>,
+    railings: &mut RailPass,
+) -> anyhow::Result<()> {
+    let primitives = &element.meshes.primitives;
+    if primitives.is_empty() {
+        return Ok(());
+    }
+    // RE-224: a mesh some face or branch of which did not decode is only
+    // part of the body (on a public reference office 357 such meshes, none of
+    // them Revit's body). Only branches left out for their view semantics
+    // leave it whole. A partial mesh whose few failed faces leave its
+    // decoded faces the body is admitted further down, after the checks
+    // that follow.
+    let failed: Vec<&String> = element
+        .meshes
+        .diagnostics
+        .iter()
+        .filter(|diagnostic| {
+            !diagnostic.ends_with(
+                crate::native_graphics_traversal::NESTED_DETAIL_FILTER_DIAGNOSTIC,
+            ) && !diagnostic
+                .ends_with(crate::native_graphics_traversal::VIEW_COMPONENT_DIAGNOSTIC)
+        })
+        .collect();
+    let partial = !failed.is_empty();
+    if partial && !partial_failures_admissible(&failed, primitives.len()) {
+        report.partial += 1;
+        return Ok(());
+    }
+    let IfcEntity::BuildingElement {
+        ifc_type,
+        location_feet: Some(origin),
+        rotation_radians,
+        extrusion,
+        solid_shape,
+        property_set: Some(set),
+        ..
+    } = &mut model.entities[index]
+    else {
+        return Ok(());
+    };
+    let (sin, cos) = (-rotation_radians.unwrap_or(0.0)).sin_cos();
+    let mut vertices = Vec::new();
+    let mut triangles = Vec::new();
+    for primitive in primitives {
+        let base = vertices.len() as u32;
+        vertices.extend(primitive.vertices.iter().map(|p| {
+            let (dx, dy) = (p[0] - origin[0], p[1] - origin[1]);
+            [dx * cos - dy * sin, dx * sin + dy * cos, p[2] - origin[2]]
+        }));
+        triangles.extend(
+            primitive
+                .triangles
+                .iter()
+                .filter(|t| t.iter().all(|&v| (v as usize) < primitive.vertices.len()))
+                .map(|t| BrepTriangle(base + t[0], base + t[1], base + t[2])),
+        );
+    }
+    if triangles.is_empty() {
+        return Ok(());
+    }
+    // A body with a curved-profile face must lie in its record box and
+    // fill most of it on each axis; otherwise it is only part of the
+    // element, and the box stays. Where the owner left out hidden
+    // components, the record box also holds geometry Revit does not
+    // draw in 3D, so one short axis is allowed. Only a body refused here,
+    // in an element with curve-only branches, has those branches read again,
+    // and outside the retry only unrotated, where their box needs no rotation.
+    let mut lines_completed = false;
+    if element.meshes.curved_extension_faces > 0
+        && !fills_record_box(
+            &vertices,
+            &triangles,
+            extrusion.as_ref(),
+            element.meshes.excluded_visibility_branches > 0,
+        )
+    {
+        // Under the retry rules a turned element's lines are read too, turned
+        // back into its frame as its vertices are.
+        let turn = rotation_radians.unwrap_or(0.0);
+        let reading = if element.meshes.excluded_non_surface_branches > 0
+            && (turn == 0.0 || crate::research::native_parametric_surface::new_rules())
+        {
+            curves(turn)
+        } else {
+            None
+        };
+        let o = [origin[0] * cos - origin[1] * sin, origin[0] * sin + origin[1] * cos, origin[2]];
+        let curve = reading.map(|reading| CurveReading {
+            extent: reading
+                .extent
+                .map(|corners| corners.map(|c| [c[0] - o[0], c[1] - o[1], c[2] - o[2]])),
+            unknown: reading.unknown,
+        });
+        if !lines_complete_box(element, &vertices, curve, &triangles, extrusion.as_ref()) {
+            return Ok(());
+        }
+        lines_completed = true;
+    }
+    // A turned family instance the retry decodes (the round-5 rules on) must
+    // fill its record box as a curved shell must, with the same one-short-axis
+    // allowance where the owner left out hidden components, or have its box
+    // completed by its lines as above. Pass one is not affected.
+    if turned
+        && crate::research::native_parametric_surface::new_rules()
+        && !lines_completed
+        && !fills_record_box(
+            &vertices,
+            &triangles,
+            extrusion.as_ref(),
+            element.meshes.excluded_visibility_branches > 0,
+        )
+    {
+        return Ok(());
+    }
+    // A curved-profile shell admitted only by the seam tolerance (the
+    // exact rim refuses it) must have no triangle longer than half its
+    // box's diagonal; the seam tolerance is not allowed to draw a body
+    // that spans across its element. Under the retry rules a strip along
+    // one side of the box does not span across it (see `crosses_box`).
+    let giant = if crate::research::native_parametric_surface::new_rules() {
+        crosses_box(&vertices, &triangles, extrusion.as_ref())
+    } else {
+        has_giant_triangle(&vertices, &triangles, extrusion.as_ref())
+    };
+    if element.meshes.seam_admitted_shell && giant {
+        return Ok(());
+    }
+    // A railing's saved mesh is taken only where it fills its record box
+    // (RE-303): every vertex within the box and each extent of the box
+    // reached, to within 0.5 ft. A railing whose graphics leave a part
+    // out, with no decoder diagnostic to say so, keeps its box, unless
+    // pass four completes it.
+    if ifc_type.as_str() == "IFCRAILING"
+        && !railing_mesh_fills_box(&vertices, extrusion.as_ref())
+    {
+        // kept for the rail pass (pass four), which can add the rails the
+        // railing's own records sweep
+        if !partial {
+            railings
+                .refused
+                .insert(element.identity.element_id, RefusedRailing { index, vertices, triangles });
+        }
+        report.partial += 1;
+        return Ok(());
+    }
+    // RE-224 partial admission (a few failed faces, see above): the
+    // decoded faces must fill the record box on every axis, each vertex
+    // within it to 0.5 ft, with no triangle spanning it, and the element
+    // must not be a railing (its own rule above). Anything else keeps its
+    // box, counted as partial.
+    if partial {
+        if ifc_type.as_str() == "IFCRAILING"
+            || !fills_record_box(&vertices, &triangles, extrusion.as_ref(), false)
+            || has_giant_triangle(&vertices, &triangles, extrusion.as_ref())
+        {
+            report.partial += 1;
+            return Ok(());
+        }
+        report.partial_admitted += 1;
+    }
+    if ifc_type.as_str() == "IFCRAILING" {
+        railings.admitted.insert(element.identity.element_id, index);
+    }
+    report.replaced += 1;
+    report.triangles += triangles.len();
+    *solid_shape = Some(SolidShape::TriangulatedFaceSet {
+        vertices_feet: vertices,
+        triangles,
+    });
+    for property in &mut set.properties {
+        if property.name == "BodySource" {
+            property.value = PropertyValue::Text(SAVED_MESH_BODY_SOURCE.into());
+        } else if property.name == SPACE_OUTLINE_SOURCE_PROPERTY {
+            property.value = PropertyValue::Text(SPACE_OUTLINE_SAVED_MESH.into());
+        }
+    }
+    Ok(())
+}
+
+/// The record box's extent along one axis can be drawn by lines the element's
+/// own graphics carry: the curve-only branches of its graphics. A curved body
+/// with no decoder diagnostic, whose own vertices fill the box on two axes,
+/// and whose vertices and curve box together fill the third to 70%, is the
+/// body: the box was widened by the lines, not by missing faces. The curve box
+/// must lie in the record box too, and every curve-only branch must be sampled.
+fn lines_complete_box(
+    element: &SavedElement,
+    vertices: &[[f64; 3]],
+    curve: Option<CurveReading>,
+    triangles: &[BrepTriangle],
+    extrusion: Option<&crate::ifc::entities::Extrusion>,
+) -> bool {
+    const TOLERANCE: f64 = 0.5;
+    const MIN_FILL: f64 = 0.7;
+    let meshes = &element.meshes;
+    let Some(CurveReading {
+        extent: Some(curve),
+        unknown: false,
+    }) = curve
+    else {
+        return false;
+    };
+    // Under the retry rules a nested detail-family filter (a view-dependent
+    // 2D symbol) may be left out, and so may hidden components (see below).
+    let retry = crate::research::native_parametric_surface::new_rules();
+    let detail_only = meshes
+        .diagnostics
+        .iter()
+        .all(|d| d.ends_with(crate::native_graphics_traversal::NESTED_DETAIL_FILTER_DIAGNOSTIC));
+    if !(meshes.diagnostics.is_empty() || retry && detail_only)
+        || (meshes.excluded_visibility_branches > 0 && !retry)
+        || vertices.is_empty()
+    {
+        return false;
+    }
+    let Some(x) = extrusion else {
+        return false;
+    };
+    let size = [x.width_feet, x.depth_feet, x.height_feet];
+    if !size.iter().all(|s| s.is_finite() && *s > 0.) {
+        return false;
+    }
+    let lo = [-size[0] / 2., -size[1] / 2., 0.];
+    let hi = [size[0] / 2., size[1] / 2., size[2]];
+    let inside = |v: &[f64; 3]| {
+        (0..3).all(|k| v[k].is_finite() && v[k] >= lo[k] - TOLERANCE && v[k] <= hi[k] + TOLERANCE)
+    };
+    if !vertices.iter().all(inside) || !curve.iter().all(inside) {
+        return false;
+    }
+    let span = |points: &[[f64; 3]], k: usize| {
+        points
+            .iter()
+            .fold((f64::INFINITY, f64::NEG_INFINITY), |(lo, hi), p| {
+                (lo.min(p[k]), hi.max(p[k]))
+            })
+    };
+    let short: Vec<usize> = (0..3)
+        .filter(|&k| {
+            let (a, b) = span(vertices, k);
+            b - a < MIN_FILL * size[k]
+        })
+        .collect();
+    let completed = |axis: usize| {
+        let (a, b) = span(vertices, axis);
+        let (c, d) = (curve[0][axis], curve[1][axis]);
+        (b.max(d) - a.min(c)) >= MIN_FILL * size[axis]
+    };
+    if retry {
+        // The retry's form: the body fills one axis itself and its lines
+        // complete the others to 70%, but for one axis left short where the
+        // owner left out hidden components (as `fills_record_box` allows). A
+        // turned window drawn from the floor (its lines) to its head is one.
+        let open = short.iter().filter(|&&k| !completed(k)).count();
+        return short.len() < 3
+            && match open {
+                0 => true,
+                1 => meshes.excluded_visibility_branches > 0,
+                _ => false,
             }
-            Ok(())
-        },
-    )?;
-    Ok(report)
+            && !crosses_box(vertices, triangles, extrusion);
+    }
+    let [axis] = short.as_slice() else {
+        return false;
+    };
+    completed(*axis) && !has_giant_triangle(vertices, triangles, extrusion)
 }
+
+/// Whether the body's vertices (in the element's frame, the record box
+/// centred on x and y, from z = 0 to its height) lie within the box to 0.5 ft
+/// and span at least 70% of it on every axis. With `hidden_excluded` (the
+/// owner left out components Revit hides in 3D), one axis may fall short, but
+/// then no triangle may be longer than half the box's diagonal: a body that
+/// is only part of the element must not span across it.
+fn fills_record_box(
+    vertices: &[[f64; 3]],
+    triangles: &[BrepTriangle],
+    extrusion: Option<&crate::ifc::entities::Extrusion>,
+    hidden_excluded: bool,
+) -> bool {
+    const TOLERANCE: f64 = 0.5;
+    const MIN_FILL: f64 = 0.7;
+    let Some(x) = extrusion else {
+        return false;
+    };
+    let size = [x.width_feet, x.depth_feet, x.height_feet];
+    if !size.iter().all(|s| s.is_finite() && *s > 0.) || vertices.is_empty() {
+        return false;
+    }
+    let lo = [-size[0] / 2., -size[1] / 2., 0.];
+    let hi = [size[0] / 2., size[1] / 2., size[2]];
+    let mut min = [f64::INFINITY; 3];
+    let mut max = [f64::NEG_INFINITY; 3];
+    for v in vertices {
+        for k in 0..3 {
+            if !v[k].is_finite() || v[k] < lo[k] - TOLERANCE || v[k] > hi[k] + TOLERANCE {
+                return false;
+            }
+            min[k] = min[k].min(v[k]);
+            max[k] = max[k].max(v[k]);
+        }
+    }
+    let short = (0..3)
+        .filter(|&k| (max[k] - min[k]) < MIN_FILL * size[k])
+        .count();
+    match short {
+        0 => true,
+        1 => hidden_excluded && !has_giant_triangle(vertices, triangles, extrusion),
+        _ => false,
+    }
+}
+
+/// Whether some triangle of the body has an edge longer than half the
+/// diagonal of its record box.
+fn has_giant_triangle(
+    vertices: &[[f64; 3]],
+    triangles: &[BrepTriangle],
+    extrusion: Option<&crate::ifc::entities::Extrusion>,
+) -> bool {
+    let Some(x) = extrusion else {
+        return false;
+    };
+    let limit = (x.width_feet.powi(2) + x.depth_feet.powi(2) + x.height_feet.powi(2)).sqrt() / 2.;
+    let length = |a: u32, b: u32| {
+        let (p, q) = (vertices[a as usize], vertices[b as usize]);
+        (0..3).map(|k| (p[k] - q[k]).powi(2)).sum::<f64>().sqrt()
+    };
+    // A flat panel lying in a plane parallel to a side of the box (an
+    // appliance's side wall) is drawn by long triangles of its own; only a
+    // triangle crossing the box out of such a plane counts.
+    let axis_flat = |t: &BrepTriangle| {
+        let (a, b, c) = (vertices[t.0 as usize], vertices[t.1 as usize], vertices[t.2 as usize]);
+        (0..3).any(|k| (a[k] - b[k]).abs() <= AXIS_FLAT_FEET && (a[k] - c[k]).abs() <= AXIS_FLAT_FEET)
+    };
+    triangles.iter().any(|t| {
+        (length(t.0, t.1) > limit || length(t.1, t.2) > limit || length(t.2, t.0) > limit)
+            && !axis_flat(t)
+    })
+}
+
+/// How far a triangle's vertices may differ along one axis for it to count as
+/// lying in a plane parallel to a side of the record box.
+const AXIS_FLAT_FEET: f64 = 0.003;
+
+/// [`has_giant_triangle`], where a long triangle running along one axis of
+/// the box, within 0.1 ft on the other two (a strip of a moulding or rail
+/// swept along a side), does not count either: it lies along the box rather
+/// than across it. Used only under the retry rules.
+fn crosses_box(
+    vertices: &[[f64; 3]],
+    triangles: &[BrepTriangle],
+    extrusion: Option<&crate::ifc::entities::Extrusion>,
+) -> bool {
+    const AXIS_STRIP_FEET: f64 = 0.1;
+    let along_one_axis = |t: &BrepTriangle| {
+        let (a, b, c) = (vertices[t.0 as usize], vertices[t.1 as usize], vertices[t.2 as usize]);
+        let spread = |k: usize| (a[k] - b[k]).abs().max((a[k] - c[k]).abs()).max((b[k] - c[k]).abs());
+        (0..3).filter(|&k| spread(k) <= AXIS_STRIP_FEET).count() >= 2
+    };
+    let crossing: Vec<BrepTriangle> = triangles
+        .iter()
+        .filter(|t| !along_one_axis(t))
+        .map(|t| BrepTriangle(t.0, t.1, t.2))
+        .collect();
+    has_giant_triangle(vertices, &crossing, extrusion)
+}
+
+/// Whether `vertices`, in the element's frame (origin at its location, the
+/// box's x and y centred on it, its z from 0 up), lie within `extrusion`'s box
+/// and reach each of its faces, to within [`RAILING_BOX_TOLERANCE_FEET`].
+fn railing_mesh_fills_box(
+    vertices: &[[f64; 3]],
+    extrusion: Option<&crate::ifc::entities::Extrusion>,
+) -> bool {
+    let Some(e) = extrusion else {
+        return false;
+    };
+    let half = [e.width_feet / 2.0, e.depth_feet / 2.0];
+    let tol = RAILING_BOX_TOLERANCE_FEET;
+    let lo = [-half[0], -half[1], 0.0];
+    let hi = [half[0], half[1], e.height_feet];
+    let mut min = [f64::INFINITY; 3];
+    let mut max = [f64::NEG_INFINITY; 3];
+    for v in vertices {
+        for k in 0..3 {
+            min[k] = min[k].min(v[k]);
+            max[k] = max[k].max(v[k]);
+        }
+    }
+    (0..3).all(|k| min[k] >= lo[k] - tol && max[k] <= hi[k] + tol)
+        && (0..3).all(|k| min[k] <= lo[k] + tol && max[k] >= hi[k] - tol)
+}
+
+/// Whether a railing's mesh, in its element's frame, lies within its record
+/// box and reaches each side and the bottom of it, to
+/// [`RAILING_BOX_TOLERANCE_FEET`], and ends at `top`, the height its records
+/// give its highest rail, to [`RAILING_TOP_TOLERANCE_FEET`]. Revit's box over
+/// a railing on a curved stair can stand well above the railing itself, so
+/// there the records say where it ends.
+fn reaches_railing_top(
+    vertices: &[[f64; 3]],
+    extrusion: Option<&crate::ifc::entities::Extrusion>,
+    top: Option<f64>,
+) -> bool {
+    let (Some(e), Some(top)) = (extrusion, top) else {
+        return false;
+    };
+    let half = [e.width_feet / 2.0, e.depth_feet / 2.0];
+    let tol = RAILING_BOX_TOLERANCE_FEET;
+    let lo = [-half[0], -half[1], 0.0];
+    let hi = [half[0], half[1], e.height_feet];
+    let mut min = [f64::INFINITY; 3];
+    let mut max = [f64::NEG_INFINITY; 3];
+    for v in vertices {
+        for k in 0..3 {
+            min[k] = min[k].min(v[k]);
+            max[k] = max[k].max(v[k]);
+        }
+    }
+    (0..3).all(|k| min[k] >= lo[k] - tol && max[k] <= hi[k] + tol)
+        && (0..3).all(|k| min[k] <= lo[k] + tol)
+        && (0..2).all(|k| max[k] >= hi[k] - tol)
+        && (max[2] - top).abs() <= RAILING_TOP_TOLERANCE_FEET
+}
+
+/// How far a railing's mesh may end from the top its records give it, feet.
+const RAILING_TOP_TOLERANCE_FEET: f64 = 0.01;
+
+/// How far a railing's saved mesh may stop short of its record box, or reach
+/// beyond it, in feet. Revit's own railing boxes sit about 0.165 ft above the top of
+/// their graphics on every railing measured on the sample projects.
+const RAILING_BOX_TOLERANCE_FEET: f64 = 0.5;
