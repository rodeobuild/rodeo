+/// curved profile, or a revolution about an ellipse or a Hermite spline.
+fn is_new_path(surface: &ParametricSurface) -> bool {
+    match surface {
+        ParametricSurface::RuledSurf {
+            profile1, profile2, ..
+        } => !(matches!(profile1, Curve::Line { .. }) && matches!(profile2, Curve::Line { .. })),
+        ParametricSurface::SurfRev { profile, .. } => {
+            matches!(profile, Curve::Ellipse { .. } | Curve::Hermite { .. })
+        }
+        ParametricSurface::ConeSurf { .. }
+        | ParametricSurface::Cylinder { .. }
+        | ParametricSurface::Hermite { .. } => false,
+    }
+}
