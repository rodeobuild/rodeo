+        for t in &primitive.triangles {
+            for (a, b) in [(0, 1), (1, 2), (2, 0)] {
+                let (Some(&pa), Some(&pb)) = (
+                    primitive.vertices.get(t[a] as usize),
+                    primitive.vertices.get(t[b] as usize),
+                ) else {
+                    continue;
+                };
+                let (ka, kb) = (key(pa), key(pb));
+                let k = if ka <= kb { (ka, kb) } else { (kb, ka) };
+                let mid = std::array::from_fn(|i| (pa[i] + pb[i]) * 0.5);
+                edges.entry(k).or_insert((0, mid)).0 += 1;
+            }
+        }
+    }
+    let open: Vec<[f64; 3]> = edges
+        .values()
+        .filter(|(n, _)| *n == 1)
+        .map(|(_, m)| *m)
+        .collect();
+    if open.is_empty() {
+        return true;
+    }
+    (0..3).any(|axis| {
+        let lo = open.iter().map(|m| m[axis]).fold(f64::INFINITY, f64::min);
+        let hi = open.iter().map(|m| m[axis]).fold(f64::NEG_INFINITY, f64::max);
+        hi - lo <= 0.05
+    })
