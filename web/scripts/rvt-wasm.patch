+                continue;
+            };
+            ensure!(tris.len() < MAX_TRIANGLES && uv.len() < MAX_VERTICES, "trimmed face exceeds its budget");
+            let q = uv.len() as u32;
+            uv.push(p);
+            let [a, b, c] = tris[t];
+            tris[t] = [a, b, q];
+            tris.push([b, c, q]);
+            tris.push([c, a, q]);
+        }
+    }
+    Ok((uv, tris))
+}
+
+/// Whether `p` lies in the trim region: inside the outer loop and in no hole.
+fn in_region(p: Uv, rings: &[Vec<Uv>]) -> bool {
+    rings.iter().filter(|r| inside(p, r)).count() % 2 == 1
+}
+
+/// Whether the segments `a`-`b` and `u`-`v` cross at a point interior to both.
+fn crosses(a: Uv, b: Uv, u: Uv, v: Uv) -> bool {
+    cross2(a, b, u) * cross2(a, b, v) < 0. && cross2(u, v, a) * cross2(u, v, b) < 0.
+}
+
+/// Positive when `d` lies inside the circumcircle of the counter-clockwise
+/// triangle (a, b, c).
+fn in_circle(a: Uv, b: Uv, c: Uv, d: Uv) -> f64 {
+    let (ax, ay) = (a[0] - d[0], a[1] - d[1]);
+    let (bx, by) = (b[0] - d[0], b[1] - d[1]);
+    let (cx, cy) = (c[0] - d[0], c[1] - d[1]);
+    let (a2, b2, c2) = (ax * ax + ay * ay, bx * bx + by * by, cx * cx + cy * cy);
+    ax * (by * c2 - b2 * cy) - ay * (bx * c2 - b2 * cx) + a2 * (bx * cy - by * cx)
+}
+
+/// The middle of the triangle `t` of `uv`.
+fn centroid(uv: &[Uv], t: [u32; 3]) -> Uv {
+    let [a, b, c] = t.map(|k| uv[k as usize]);
+    [(a[0] + b[0] + c[0]) / 3., (a[1] + b[1] + c[1]) / 3.]
+}
+
+/// The circumcentre of the triangle (a, b, c), or `None` when it is flat.
+fn circumcentre(a: Uv, b: Uv, c: Uv) -> Option<Uv> {
+    let (bx, by) = (b[0] - a[0], b[1] - a[1]);
+    let (cx, cy) = (c[0] - a[0], c[1] - a[1]);
+    let d = 2. * (bx * cy - by * cx);
+    if d.abs() <= 1e-18 {
+        return None;
+    }
+    let (b2, c2) = (bx * bx + by * by, cx * cx + cy * cy);
+    Some([a[0] + (cy * b2 - by * c2) / d, a[1] + (bx * c2 - cx * b2) / d])
+}
+
+/// Bowyer-Watson Delaunay triangulation of `pts`, counter-clockwise. Points
+/// are inserted one at a time into a super-triangle, which is removed at the
+/// end. Points must be distinct.
+fn delaunay(pts: &[Uv]) -> Vec<[u32; 3]> {
+    let n = pts.len();
+    let min: Uv = std::array::from_fn(|k| pts.iter().map(|p| p[k]).fold(f64::INFINITY, f64::min));
+    let max: Uv = std::array::from_fn(|k| pts.iter().map(|p| p[k]).fold(f64::NEG_INFINITY, f64::max));
+    let span = (max[0] - min[0]).max(max[1] - min[1]).max(1e-9);
+    let (mx, my) = ((min[0] + max[0]) / 2., (min[1] + max[1]) / 2.);
+    let mut all = pts.to_vec();
+    let _ = (mx, my);
+    // The round-6 rules need a super-triangle far larger than the samples:
+    // at 100 spans, near-collinear boundary samples lose hull edges.
+    let k = if crate::research::native_parametric_surface::new_rules() { 1e4 } else { 100. };
+    all.push([mx - k * span, my - k * span]);
+    all.push([mx + k * span, my - k * span]);
+    all.push([mx, my + k * span]);
+    let s = n as u32;
+    let mut tris: Vec<[u32; 3]> = vec![[s, s + 1, s + 2]];
+    for (i, &p) in pts.iter().enumerate() {
+        // Directed edges of the triangles whose circumcircle holds p.
+        let mut cavity = BTreeSet::new();
+        let mut keep = Vec::with_capacity(tris.len() + 2);
+        for t in tris.drain(..) {
+            let [a, b, c] = t;
+            if in_circle(all[a as usize], all[b as usize], all[c as usize], p) > 0. {
+                cavity.extend([(a, b), (b, c), (c, a)]);
+            } else {
+                keep.push(t);
+            }
+        }
+        for &(a, b) in &cavity {
+            if !cavity.contains(&(b, a)) {
+                keep.push([a, b, i as u32]);
+            }
+        }
+        tris = keep;
+    }
+    tris.retain(|t| t.iter().all(|&k| k < s));
+    tris
+}
+
+/// The third vertex of `t` when `t` has
+/// the directed edge `u`-`v`, is the third vertex.
+fn third_of(t: [u32; 3], u: u32, v: u32) -> Option<u32> {
+    (0..3)
+        .find(|&k| t[k] == u && t[(k + 1) % 3] == v)
+        .map(|k| t[(k + 2) % 3])
+}
+
+/// The two triangles on either side of the edge `u`-`v`, each with its third
+/// vertex: the one that has `u`-`v` in its order, then the one with `v`-`u`.
+fn sides(tris: &[[u32; 3]], u: u32, v: u32) -> Option<((usize, u32), (usize, u32))> {
+    let a = tris.iter().enumerate().find_map(|(i, t)| third_of(*t, u, v).map(|x| (i, x)));
+    let b = tris.iter().enumerate().find_map(|(i, t)| third_of(*t, v, u).map(|y| (i, y)));
+    Some((a?, b?))
+}
+
+/// Each constraint with the trim samples that lie exactly on it (within
+/// 1e-12 of its span) split out: the constraint `a`-`b` becomes the chain
+/// `a`, `v1`, ..., `b` through those samples, so no new point is needed.
+fn split_constraints(pts: &[Uv], constraints: &[(u32, u32)]) -> Vec<(u32, u32)> {
+    let mut out = Vec::with_capacity(constraints.len());
+    for &(a, b) in constraints {
+        let (pa, pb) = (pts[a as usize], pts[b as usize]);
+        let len = ((pb[0] - pa[0]).powi(2) + (pb[1] - pa[1]).powi(2)).sqrt();
+        let mut on: Vec<(f64, u32)> = Vec::new();
+        for (k, &p) in pts.iter().enumerate() {
+            let k = k as u32;
+            if k == a || k == b {
+                continue;
+            }
+            let along = ((p[0] - pa[0]) * (pb[0] - pa[0]) + (p[1] - pa[1]) * (pb[1] - pa[1])) / len;
+            if cross2(pa, pb, p).abs() / len <= 1e-12 && along > 0. && along < len {
+                on.push((along, k));
+            }
+        }
+        on.sort_by(|x, y| x.0.total_cmp(&y.0));
+        let mut prev = a;
+        for (_, k) in on {
+            out.push((prev, k));
+            prev = k;
+        }
+        out.push((prev, b));
+    }
+    out
+}
+
+/// Whether `p` lies in the closed triangle (a, b, c) of counter-clockwise order.
+fn in_closed_triangle(a: Uv, b: Uv, c: Uv, p: Uv) -> bool {
+    cross2(a, b, p) >= 0. && cross2(b, c, p) >= 0. && cross2(c, a, p) >= 0.
+}
+
+/// Ear clipping of a simple counter-clockwise polygon of sample indices.
+/// Returns its triangles, or `None` when no ear exists (a degenerate loop).
+fn ear_clip(pts: &[Uv], mut poly: Vec<u32>) -> Option<Vec<[u32; 3]>> {
+    let mut out = Vec::with_capacity(poly.len().saturating_sub(2));
+    while poly.len() > 3 {
+        let n = poly.len();
+        let mut found = None;
+        for i in 0..n {
+            let (p, c, q) = (poly[(i + n - 1) % n], poly[i], poly[(i + 1) % n]);
+            let (pp, pc, pq) = (pts[p as usize], pts[c as usize], pts[q as usize]);
+            if cross2(pp, pc, pq) <= 0. {
+                continue;
+            }
+            let blocked = poly.iter().any(|&r| {
+                r != p && r != c && r != q && in_closed_triangle(pp, pc, pq, pts[r as usize])
+            });
+            if !blocked {
+                found = Some(i);
+                break;
+            }
+        }
+        let i = found?;
+        let n = poly.len();
+        out.push([poly[(i + n - 1) % n], poly[i], poly[(i + 1) % n]]);
+        poly.remove(i);
+    }
+    let (x, y, z) = (poly[0], poly[1], poly[2]);
+    if cross2(pts[x as usize], pts[y as usize], pts[z as usize]) > 0. {
+        out.push([x, y, z]);
+    }
+    Some(out)
+}
+
+/// Inserts the constraint `a`-`b` by cavity retriangulation (Anglada 1997):
+/// the triangles it crosses are removed, and the two polygons they leave on
+/// either side of it are ear-clipped. No point is added. Returns `false` when
+/// the cavity is not a simple polygon on each side.
+fn cavity_insert(pts: &[Uv], tris: &mut Vec<[u32; 3]>, a: u32, b: u32) -> bool {
+    let (pa, pb) = (pts[a as usize], pts[b as usize]);
+    let crossed: Vec<usize> = (0..tris.len())
+        .filter(|&i| {
+            let t = tris[i];
+            (0..3).any(|k| {
+                let (u, v) = (t[k], t[(k + 1) % 3]);
+                u != a && u != b && v != a && v != b && crosses(pa, pb, pts[u as usize], pts[v as usize])
+            })
+        })
+        .collect();
+    if crossed.is_empty() {
+        return false;
+    }
+    let mut directed = BTreeSet::new();
+    for &i in &crossed {
+        let t = tris[i];
+        for k in 0..3 {
+            directed.insert((t[k], t[(k + 1) % 3]));
+        }
+    }
+    // Boundary edges of the cavity, each on one side of a-b.
+    let mut sides: [Vec<(u32, u32)>; 2] = [Vec::new(), Vec::new()];
+    for &(u, v) in &directed {
+        if directed.contains(&(v, u)) {
+            continue;
+        }
+        let p = if u == a || u == b { v } else { u };
+        let s = cross2(pa, pb, pts[p as usize]);
+        if s == 0. {
+            return false;
+        }
+        sides[usize::from(s < 0.)].push((u, v));
+    }
+    let mut new_tris = Vec::new();
+    for side in &sides {
+        // The chain of the cavity boundary on this side, from a to b.
+        let mut adj: BTreeMap<u32, Vec<u32>> = BTreeMap::new();
+        for &(u, v) in side {
+            adj.entry(u).or_default().push(v);
+            adj.entry(v).or_default().push(u);
+        }
+        if adj.get(&a).map_or(true, |n| n.len() != 1) || adj.get(&b).map_or(true, |n| n.len() != 1) {
+            return false;
+        }
+        let mut path = vec![a];
+        let mut prev = None;
+        let mut cur = a;
+        while cur != b {
+            let next: Vec<u32> = adj
+                .get(&cur)
+                .map(|n| n.iter().copied().filter(|&x| Some(x) != prev).collect())
+                .unwrap_or_default();
+            if next.len() != 1 || path.len() > side.len() + 1 {
+                return false;
+            }
+            prev = Some(cur);
+            cur = next[0];
+            path.push(cur);
+        }
+        let area: f64 = path
+            .iter()
+            .zip(path.iter().cycle().skip(1))
+            .map(|(&u, &v)| {
+                let (p, q) = (pts[u as usize], pts[v as usize]);
+                p[0] * q[1] - q[0] * p[1]
+            })
+            .sum();
+        if area.abs() <= 1e-18 {
+            return false;
+        }
+        if area < 0. {
+            path.reverse();
+        }
+        match ear_clip(pts, path) {
+            Some(t) => new_tris.extend(t),
+            None => return false,
+        }
+    }
+    let crossed: BTreeSet<usize> = crossed.into_iter().collect();
+    let mut kept: Vec<[u32; 3]> = tris
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| !crossed.contains(i))
+        .map(|(_, t)| *t)
+        .collect();
+    kept.extend(new_tris);
+    *tris = kept;
+    true
+}
+
+/// Forces each constraint segment into the triangulation as an edge. The
+/// edges crossing it are flipped until none does (Sloan's method); where
+/// that fails under the round-6 rules, the triangulation is restored and the
+/// constraint is inserted by cavity retriangulation instead. A constraint
+/// that still is not an edge is refused.
+fn constrain(pts: &[Uv], tris: &mut Vec<[u32; 3]>, constraints: &[(u32, u32)]) -> Result<()> {
+    let round6 = crate::research::native_parametric_surface::new_rules();
+    let segments = if round6 {
+        split_constraints(pts, constraints)
+    } else {
+        for &(a, b) in constraints {
+            let (pa, pb) = (pts[a as usize], pts[b as usize]);
+            let len2 = (pb[0] - pa[0]).powi(2) + (pb[1] - pa[1]).powi(2);
+            for (k, &p) in pts.iter().enumerate() {
+                let k = k as u32;
+                if k == a || k == b {
+                    continue;
+                }
+                let along = (p[0] - pa[0]) * (pb[0] - pa[0]) + (p[1] - pa[1]) * (pb[1] - pa[1]);
+                ensure!(
+                    !(cross2(pa, pb, p).abs() <= 1e-12 && along > 0. && along < len2),
+                    "trim sample lies on another trim edge"
+                );
+            }
+        }
+        constraints.to_vec()
+    };
+    for &(a, b) in &segments {
+        let (pa, pb) = (pts[a as usize], pts[b as usize]);
+        let mut edges: Vec<(u32, u32)> = tris
+            .iter()
+            .flat_map(|t| [(t[0], t[1]), (t[1], t[2]), (t[2], t[0])])
+            .map(|(u, v)| (u.min(v), u.max(v)))
+            .collect();
+        if edges.contains(&(a.min(b), a.max(b))) {
+            continue;
+        }
+        let backup = round6.then(|| tris.clone());
+        edges.sort_unstable();
+        edges.dedup();
+        let mut queue: VecDeque<(u32, u32)> = edges
+            .iter()
+            .copied()
+            .filter(|&(u, v)| crosses(pa, pb, pts[u as usize], pts[v as usize]))
+            .collect();
+        let mut steps = 0usize;
+        let mut sloan_ok = true;
+        while let Some((u, v)) = queue.pop_front() {
+            steps += 1;
+            if steps > 1_000_000 {
+                ensure!(round6, "trim constraint recovery stalled");
+                sloan_ok = false;
+                break;
+            }
+            if !crosses(pa, pb, pts[u as usize], pts[v as usize]) {
+                continue;
+            }
+            let Some(((i, x), (j, y))) = sides(tris, u, v) else {
+                continue;
+            };
+            let (pu, pv) = (pts[u as usize], pts[v as usize]);
+            let (px, py) = (pts[x as usize], pts[y as usize]);
+            // The quadrilateral u, y, v, x is convex exactly when its
+            // diagonals u-v and x-y cross.
+            if cross2(px, py, pu) * cross2(px, py, pv) >= 0. {
+                queue.push_back((u, v));
+                continue;
+            }
+            tris[i] = [u, y, x];
+            tris[j] = [v, x, y];
+            if crosses(pa, pb, px, py) {
+                queue.push_back((x.min(y), x.max(y)));
+            }
+        }
+        let recovered = |tris: &[[u32; 3]]| {
+            tris.iter().any(|t| {
+                [(t[0], t[1]), (t[1], t[2]), (t[2], t[0])]
+                    .iter()
+                    .any(|&(u, v)| (u, v) == (a, b) || (v, u) == (a, b))
+            })
+        };
+        if sloan_ok && recovered(tris) {
+            continue;
+        }
+        if let Some(backup) = backup {
+            *tris = backup;
+            if cavity_insert(pts, tris, a, b) && recovered(tris) {
+                continue;
+            }
+        }
+        bail!("trim boundary not recoverable");
+    }
+    Ok(())
+}
+
+/// The deviation a triangle touching the trim boundary may show: the largest
+/// sagitta of the boundary's own samples, the chord each saved sample pair
+/// makes against the surface at the middle of its UV span. Revit's boundary
+/// is drawn with that deviation, so a triangle along it is not held finer
+/// than the samples are; it is clamped to [`CHORD`, `DISPLAY_TOLERANCE`].
+/// Interior triangles keep [`CHORD`].
+fn boundary_tolerance(surface: &ParametricSurface, rings: &[&[Uv]]) -> Result<f64> {
+    let mut sagitta = 0_f64;
+    for ring in rings {
+        for k in 0..ring.len() {
+            let (a, b) = (ring[k], ring[(k + 1) % ring.len()]);
+            let (pa, pb) = (point3(surface, a)?, point3(surface, b)?);
+            let chord: [f64; 3] = std::array::from_fn(|i| (pa[i] + pb[i]) / 2.);
+            let mid = point3(surface, [(a[0] + b[0]) / 2., (a[1] + b[1]) / 2.])?;
+            sagitta = sagitta.max(distance(mid, chord));
+        }
+    }
+    Ok(sagitta.clamp(CHORD, DISPLAY_TOLERANCE))
+}
+
+/// Whether every triangle's surface stays within its tolerance of its linear
+/// mapping: [`CHORD`] for interior triangles, `boundary_tol` for those with a
+/// vertex among the first `boundary_count` (the trim samples, which are not
+/// refined).
+fn within_chord(
+    surface: &ParametricSurface,
+    uv: &[Uv],
+    tris: &[[u32; 3]],
+    boundary_count: usize,
+    boundary_tol: f64,
+) -> Result<bool> {
+    let verts3: Vec<[f64; 3]> = uv.iter().map(|&p| point3(surface, p)).collect::<Result<_>>()?;
+    for &[a, b, c] in tris {
+        let tol = if [a, b, c].iter().any(|&k| (k as usize) < boundary_count) {
+            boundary_tol
+        } else {
+            CHORD
+        };
+        let (pa, pb, pc) = (uv[a as usize], uv[b as usize], uv[c as usize]);
+        let (qa, qb, qc) = (verts3[a as usize], verts3[b as usize], verts3[c as usize]);
+        let samples = [
+            ([1. / 3., 1. / 3., 1. / 3.], [(pa[0] + pb[0] + pc[0]) / 3., (pa[1] + pb[1] + pc[1]) / 3.]),
+            ([0.5, 0.5, 0.], [(pa[0] + pb[0]) / 2., (pa[1] + pb[1]) / 2.]),
+            ([0., 0.5, 0.5], [(pb[0] + pc[0]) / 2., (pb[1] + pc[1]) / 2.]),
+            ([0.5, 0., 0.5], [(pa[0] + pc[0]) / 2., (pa[1] + pc[1]) / 2.]),
+        ];
+        for (w, s) in samples {
+            let true_point = point3(surface, s)?;
+            let linear: [f64; 3] = std::array::from_fn(|k| w[0] * qa[k] + w[1] * qb[k] + w[2] * qc[k]);
+            if distance(true_point, linear) > tol {
+                return Ok(false);
+            }
+        }
+    }
+    Ok(true)
+}
+
+/// The triangles whose surface leaves their linear mapping by more than the
+/// tolerance they are held to: [`CHORD`] for interior triangles, `boundary_tol`
+/// for those with a vertex among the first `boundary_count` (the trim samples,
+/// which are not refined).
+fn bad_triangles(
+    surface: &ParametricSurface,
+    uv: &[Uv],
+    tris: &[[u32; 3]],
+    boundary_count: usize,
+    boundary_tol: f64,
+    interior_tol: f64,
+) -> Result<Vec<usize>> {
+    let verts3: Vec<[f64; 3]> = uv.iter().map(|&p| point3(surface, p)).collect::<Result<_>>()?;
+    let mut bad = Vec::new();
+    for (ti, &[a, b, c]) in tris.iter().enumerate() {
+        let tol = if [a, b, c].iter().any(|&k| (k as usize) < boundary_count) {
+            boundary_tol
+        } else {
+            interior_tol
+        };
+        let (pa, pb, pc) = (uv[a as usize], uv[b as usize], uv[c as usize]);
+        let (qa, qb, qc) = (verts3[a as usize], verts3[b as usize], verts3[c as usize]);
+        let samples = [
+            ([1. / 3., 1. / 3., 1. / 3.], [(pa[0] + pb[0] + pc[0]) / 3., (pa[1] + pb[1] + pc[1]) / 3.]),
+            ([0.5, 0.5, 0.], [(pa[0] + pb[0]) / 2., (pa[1] + pb[1]) / 2.]),
+            ([0., 0.5, 0.5], [(pb[0] + pc[0]) / 2., (pb[1] + pc[1]) / 2.]),
+            ([0.5, 0., 0.5], [(pa[0] + pc[0]) / 2., (pa[1] + pc[1]) / 2.]),
+        ];
+        for (w, s) in samples {
+            let true_point = point3(surface, s)?;
+            let linear: [f64; 3] = std::array::from_fn(|k| w[0] * qa[k] + w[1] * qb[k] + w[2] * qc[k]);
+            if distance(true_point, linear) > tol {
+                bad.push(ti);
+                break;
+            }
+        }
+    }
+    Ok(bad)
+}
+
+/// Whether `e` is the budget refusal, which sends a face to the CDT.
+fn is_budget(e: &anyhow::Error) -> bool {
+    e.to_string() == "trimmed face exceeds its budget"
+}
+
+/// The lattice triangulation of a single-loop trim: the boundary samples
+/// triangulated by earcut, then interior lattice points at the coarsest
+/// division whose triangles all meet their chord tolerance. `None` when no
+/// division does, or the lattice runs over budget.
+fn lattice_mesh(
+    uv: &[Uv],
+    hole_starts: &[u32],
+    outer: &[Uv],
+    holes: &[Vec<Uv>],
+    surface: &ParametricSurface,
+    boundary_count: usize,
+    boundary_tol: f64,
+    expected: f64,
+) -> Result<Option<(Vec<Uv>, Vec<[u32; 3]>)>> {
+    let mut indices = Vec::<u32>::new();
+    earcut::Earcut::new().earcut(uv.iter().copied(), hole_starts, &mut indices);
+    ensure!(!indices.is_empty() && indices.len() % 3 == 0, "triangulation failed");
+    let mut tris: Vec<[u32; 3]> = Vec::new();
+    let mut sum = 0.;
+    for t in indices.chunks_exact(3) {
+        let t = [t[0], t[1], t[2]];
+        ensure!(t.iter().all(|&k| (k as usize) < uv.len()), "triangle bounds");
+        let a = cross2(uv[t[0] as usize], uv[t[1] as usize], uv[t[2] as usize]);
+        if a.abs() <= 1e-14 {
+            continue;
+        }
+        sum += a.abs() * 0.5;
+        tris.push(if a > 0. { t } else { [t[0], t[2], t[1]] });
+    }
+    ensure!(
+        (sum - expected).abs() <= 1e-7 * expected.max(1e-6),
+        "triangulated area mismatch"
+    );
+    // Interior points are added on a lattice, one containing triangle at a
+    // time, so every boundary sample and boundary edge stays as it is. The
+    // coarsest lattice whose triangles all stay within CHORD of the surface is
+    // taken.
+    for divisions in [0_usize, 8, 16, 32, 64] {
+        let (points, tris) = match lattice_refine(outer, holes, uv, &tris, divisions) {
+            Ok(found) => found,
+            Err(e) if is_budget(&e) => return Ok(None),
+            Err(e) => return Err(e),
+        };
+        if within_chord(surface, &points, &tris, boundary_count, boundary_tol)? {
+            return Ok(Some((points, tris)));
+        }
+    }
+    Ok(None)
+}
+
+/// The constrained Delaunay triangulation of the trim's boundary samples in
+/// UV, refined inside the trim until every triangle meets its tolerance. Only
+/// interior points are added: a candidate within `margin` of a trim edge is
+/// not, so a face that needs a boundary split is refused.
+fn cdt_mesh(
+    surface: &ParametricSurface,
+    rings: &[Vec<Uv>],
+    boundary: &[Uv],
+    boundary_edges: &BTreeSet<(u32, u32)>,
+    boundary_count: usize,
+    boundary_tol: f64,
+    expected: f64,
+) -> Result<(Vec<Uv>, Vec<[u32; 3]>)> {
+    let mut seen_samples = BTreeSet::new();
+    for p in boundary {
+        ensure!(
+            seen_samples.insert([p[0].to_bits(), p[1].to_bits()]),
+            "duplicate trim sample"
+        );
+    }
+    let constraints: Vec<(u32, u32)> = boundary_edges.iter().copied().collect();
+    let span = (0..2)
+        .map(|k| {
+            let lo = rings.iter().flatten().map(|p| p[k]).fold(f64::INFINITY, f64::min);
+            let hi = rings.iter().flatten().map(|p| p[k]).fold(f64::NEG_INFINITY, f64::max);
+            hi - lo
+        })
+        .fold(1e-9_f64, f64::max);
+    let gap2 = (1e-9 * span) * (1e-9 * span);
+    let new_rules = crate::research::native_parametric_surface::new_rules();
+    let margin = if new_rules { 1e-3 * span } else { 1e-6 * span };
+    let margin2 = margin * margin;
+    let mut points = boundary.to_vec();
+    // Points are binned in a GRID x GRID cell grid over the outer loop's box,
+    // as linked lists in Vec indices, so the duplicate test looks only at the
+    // nearby cells.
+    const GRID: usize = 64;
+    let origin: Uv = std::array::from_fn(|k| rings.iter().flatten().map(|p| p[k]).fold(f64::INFINITY, f64::min));
+    let cell_w = span / GRID as f64;
+    let cell_of = |p: Uv| -> usize {
+        let cx = (((p[0] - origin[0]) / cell_w).floor().max(0.) as usize).min(GRID - 1);
+        let cy = (((p[1] - origin[1]) / cell_w).floor().max(0.) as usize).min(GRID - 1);
+        cy * GRID + cx
+    };
+    let mut head = vec![u32::MAX; GRID * GRID];
+    let mut next: Vec<u32> = Vec::with_capacity(points.len() + 64);
+    for (i, &p) in points.iter().enumerate() {
+        let c = cell_of(p);
+        next.push(head[c]);
+        head[c] = i as u32;
+    }
+    let mut done = None;
+    let mut stuck: Option<(Uv, Uv)> = None;
+    for round in 0..=REFINE_ROUNDS {
+        ensure!(points.len() < MAX_VERTICES, "trimmed face exceeds its budget");
+        let mut tris = delaunay(&points);
+        constrain(&points, &mut tris, &constraints)?;
+        tris.retain(|t| in_region(centroid(&points, *t), rings));
+        ensure!(tris.len() < MAX_TRIANGLES, "trimmed face exceeds its budget");
+        let bad = bad_triangles(surface, &points, &tris, boundary_count, boundary_tol, CHORD)?;
+        if bad.is_empty() {
+            done = Some(tris);
+            break;
+        }
+        if round == REFINE_ROUNDS {
+            break;
+        }
+        ensure!(
+            points.len() - boundary_count + bad.len() <= REFINE_POINTS,
+            "trimmed face needs too many refinement points"
+        );
+        if new_rules {
+            stuck = chord_pair(surface, &points, &tris, &bad, boundary_count)?;
+        }
+        let mut added = false;
+        for ti in bad {
+            let t = tris[ti];
+            // Boundary samples cannot be split, so near a sharp trim corner a
+            // bad triangle may never meet its tolerance. Below MIN_EDGE it is
+            // left as it is, which keeps refinement finite.
+            let q: [[f64; 3]; 3] = [
+                point3(surface, points[t[0] as usize])?,
+                point3(surface, points[t[1] as usize])?,
+                point3(surface, points[t[2] as usize])?,
+            ];
+            if distance(q[0], q[1]).max(distance(q[1], q[2])).max(distance(q[2], q[0])) <= MIN_EDGE {
+                continue;
+            }
+            let [a, b, c] = t.map(|k| points[k as usize]);
+            let near_constraint = |p: Uv| {
+                constraints
+                    .iter()
+                    .any(|&(u, v)| segment_distance2(p, points[u as usize], points[v as usize]) <= margin2)
+            };
+            let mut p = circumcentre(a, b, c)
+                .filter(|p| in_region(*p, rings))
+                .unwrap_or_else(|| centroid(&points, t));
+            if near_constraint(p) {
+                // Under the round-6 rules a candidate within 1e-3 of the span
+                // of a trim constraint is not used: the centroid is tried, and
+                // a triangle whose centroid is also that close is left as it is.
+                if !new_rules {
+                    continue;
+                }
+                p = centroid(&points, t);
+                if near_constraint(p) {
+                    continue;
+                }
+            }
+            let c = cell_of(p);
+            let (cx, cy) = (c % GRID, c / GRID);
+            let mut duplicate = false;
+            for ny in cy.saturating_sub(1)..=(cy + 1).min(GRID - 1) {
+                for nx in cx.saturating_sub(1)..=(cx + 1).min(GRID - 1) {
+                    let mut j = head[ny * GRID + nx];
+                    while j != u32::MAX {
+                        let q = points[j as usize];
+                        if (q[0] - p[0]).powi(2) + (q[1] - p[1]).powi(2) <= gap2 {
+                            duplicate = true;
+                        }
+                        j = next[j as usize];
+                    }
+                }
+            }
+            if !duplicate {
+                points.push(p);
+                next.push(head[c]);
+                head[c] = (points.len() - 1) as u32;
+                added = true;
+            }
+        }
+        if !added {
+            break;
+        }
+    }
+    let done = match done {
+        Some(done) => done,
+        None => match stuck {
+            Some((a, b)) => return Err(anyhow::Error::new(ChordEdge { a, b })),
+            None => bail!("trimmed face needs a finer triangulation"),
+        },
+    };
+    let sum: f64 = done
+        .iter()
+        .map(|t| cross2(points[t[0] as usize], points[t[1] as usize], points[t[2] as usize]).abs() * 0.5)
+        .sum();
+    ensure!(
+        (sum - expected).abs() <= 1e-7 * expected.max(1e-6),
+        "triangulated area mismatch"
+    );
+    Ok((points, done))
+}
+
+/// A point in model space.
+type Point = [f64; 3];
+
+thread_local! {
+    /// Shared trim edges (by edge object index) that take extra 3D points,
+    /// set only while the round-8 retry of one geometry object runs.
+    static SPLITS: std::cell::RefCell<BTreeMap<usize, Vec<Point>>> =
+        std::cell::RefCell::new(BTreeMap::new());
+    /// Whether any edge carries a split point (a cheap test for the loops).
+    static SPLIT_ACTIVE: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    /// The (face, edge) pairs whose boundary took a split point.
+    static CONSUMED: std::cell::RefCell<BTreeSet<(usize, usize)>> =
+        std::cell::RefCell::new(BTreeSet::new());
+}
+
+/// A boundary chord that the triangulation cannot meet within tolerance,
+/// with its two trim samples in UV. Its edge can be split in 3D.
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct ChordEdge {
+    pub(crate) a: Uv,
+    pub(crate) b: Uv,
+}
+
+impl std::fmt::Display for ChordEdge {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("trimmed face needs a finer triangulation")
+    }
+}
+
+impl std::error::Error for ChordEdge {}
+
+/// The longest boundary chord of a bad triangle.
+fn chord_pair(
+    surface: &ParametricSurface,
+    uv: &[Uv],
+    tris: &[[u32; 3]],
+    bad: &[usize],
+    boundary_count: usize,
+) -> Result<Option<(Uv, Uv)>> {
+    let mut best: Option<(f64, Uv, Uv)> = None;
+    for &ti in bad {
+        let t = tris[ti];
+        for k in 0..3 {
+            let (u, v) = (t[k], t[(k + 1) % 3]);
+            if u as usize >= boundary_count || v as usize >= boundary_count {
+                continue;
+            }
+            let len = distance(point3(surface, uv[u as usize])?, point3(surface, uv[v as usize])?);
+            if best.map_or(true, |b| len > b.0) {
+                best = Some((len, uv[u as usize], uv[v as usize]));
+            }
+        }
+    }
+    Ok(best.map(|(_, a, b)| (a, b)))
+}
+
+/// The point of `surface` nearest to `p`: a grid start, then Gauss-Newton on
+/// the (u, v) parameters, clamped to the surface's bounds.
+pub(crate) fn nearest_uv(surface: &ParametricSurface, p: Point) -> Result<Uv> {
+    let [[u0, v0], [u1, v1]] = surface.bounds();
+    let n = 24;
+    let mut best = (f64::INFINITY, [u0, v0]);
+    for i in 0..=n {
+        for j in 0..=n {
+            let uv = [
+                u0 + (u1 - u0) * i as f64 / n as f64,
+                v0 + (v1 - v0) * j as f64 / n as f64,
+            ];
+            if let Ok(q) = surface.evaluate(uv[0], uv[1]) {
+                let d = distance(q, p);
+                if d < best.0 {
+                    best = (d, uv);
+                }
+            }
+        }
+    }
+    let mut uv = best.1;
+    let sub = |a: Point, b: Point| [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
+    let dot = |a: Point, b: Point| a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+    for _ in 0..60 {
+        let q = surface.evaluate(uv[0], uv[1])?;
+        let r = sub(q, p);
+        let (up, um) = ((uv[0] + (u1 - u0) * 1e-7).min(u1), (uv[0] - (u1 - u0) * 1e-7).max(u0));
+        let (vp, vm) = ((uv[1] + (v1 - v0) * 1e-7).min(v1), (uv[1] - (v1 - v0) * 1e-7).max(v0));
+        let qu = sub(surface.evaluate(up, uv[1])?, surface.evaluate(um, uv[1])?);
+        let qv = sub(surface.evaluate(uv[0], vp)?, surface.evaluate(uv[0], vm)?);
+        let du: Point = std::array::from_fn(|k| qu[k] / (up - um).max(1e-300));
+        let dv: Point = std::array::from_fn(|k| qv[k] / (vp - vm).max(1e-300));
+        let (a11, a12, a22) = (dot(du, du), dot(du, dv), dot(dv, dv));
+        let (b1, b2) = (-dot(du, r), -dot(dv, r));
+        let det = a11 * a22 - a12 * a12;
+        if det.abs() < 1e-300 {
+            break;
+        }
+        let d0 = (b1 * a22 - b2 * a12) / det;
+        let d1 = (a11 * b2 - a12 * b1) / det;
+        uv[0] = (uv[0] + d0).clamp(u0, u1);
+        uv[1] = (uv[1] + d1).clamp(v0, v1);
+        if d0.abs() + d1.abs() < 1e-13 {
+            break;
+        }
+    }
+    Ok(uv)
+}
+
+/// A point on both surfaces near `uv` of `si`: alternating nearest-point
+/// projections, which converge onto the surfaces' intersection, the shared
+/// trim edge when the two faces meet along it. `sj` is the second surface's
+/// nearest point to a 3D point.
+fn edge_point(si: &ParametricSurface, sj: &dyn Fn(Point) -> Result<Point>, uv: Uv) -> Result<Point> {
+    let mut p = si.evaluate(uv[0], uv[1])?;
+    for _ in 0..60 {
+        let q = sj(p)?;
+        let ui = nearest_uv(si, q)?;
+        let p2 = si.evaluate(ui[0], ui[1])?;
+        let gap = distance(p2, q);
+        p = p2;
+        if gap < 1e-9 {
+            return Ok(std::array::from_fn(|k| 0.5 * (p2[k] + q[k])));
+        }
+    }
+    bail!("shared edge point did not converge")
+}
+
+/// The UV samples of edge `e` on the side of `fi`, with the shared split
+/// points of `e` inserted where they fall along it. With `record`, the pair
+/// is marked consumed, which the element check reads.
+fn apply_splits(
+    e: usize,
+    fi: usize,
+    surface: &ParametricSurface,
+    points: Vec<Uv>,
+    record: bool,
+) -> Result<Vec<Uv>> {
+    apply_splits_by(e, fi, &|p| nearest_uv(surface, p), points, record)
+}
+
+/// [`apply_splits`] for a face whose UV of a 3D point is `to_uv`.
+pub(crate) fn apply_splits_by(
+    e: usize,
+    fi: usize,
+    to_uv: &dyn Fn(Point) -> Result<Uv>,
+    mut points: Vec<Uv>,
+    record: bool,
+) -> Result<Vec<Uv>> {
+    if !SPLIT_ACTIVE.with(|c| c.get()) {
+        return Ok(points);
+    }
+    let extra = SPLITS.with(|s| s.borrow().get(&e).cloned().unwrap_or_default());
+    if extra.is_empty() || points.len() < 2 {
+        return Ok(points);
+    }
+    if record {
+        CONSUMED.with(|c| c.borrow_mut().insert((fi, e)));
+    }
+    for p3 in extra {
+        let uv = to_uv(p3)?;
+        if points
+            .iter()
+            .any(|q| (q[0] - uv[0]).abs() < 1e-9 && (q[1] - uv[1]).abs() < 1e-9)
+        {
+            continue;
+        }
+        let mut best = (f64::INFINITY, 0usize);
+        for k in 0..points.len() - 1 {
+            let d = segment_distance(uv, points[k], points[k + 1]);
+            if d < best.0 {
+                best = (d, k);
+            }
+        }
+        points.insert(best.1 + 1, uv);
+    }
+    Ok(points)
+}
+
+/// A plane's origin and its two axis vectors.
+pub(crate) fn plane_frame(g: &ObjectGraph, plane: usize) -> Result<(Point, Point, Point)> {
+    let fields = &g.objects[plane].fields;
+    let read = |v: &serde_json::Value| -> Result<Point> {
+        let a = v.as_array().context("plane vector")?;
+        ensure!(a.len() == 3, "plane vector length");
+        Ok(std::array::from_fn(|k| a[k].as_f64().unwrap_or(f64::NAN)))
+    };
+    let frame = (read(&fields["m_origin"])?, read(&fields["m_xVec"])?, read(&fields["m_yVec"])?);
+    ensure!(
+        [frame.0, frame.1, frame.2].iter().flatten().all(|c| c.is_finite()),
+        "plane frame"
+    );
+    Ok(frame)
+}
+
+fn dot3(a: Point, b: Point) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+fn cross3(a: Point, b: Point) -> Point {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+
+/// Clears the shared split table and the consumed record.
+pub(crate) fn splits_clear() {
+    SPLIT_ACTIVE.with(|c| c.set(false));
+    SPLITS.with(|s| s.borrow_mut().clear());
+    CONSUMED.with(|c| c.borrow_mut().clear());
+}
+
+/// Forgets which faces consumed a split, before a round of meshing.
+pub(crate) fn consumed_clear() {
+    CONSUMED.with(|c| c.borrow_mut().clear());
+}
+
+/// Whether face `fi` took the splits of edge `e` in the last round.
+pub(crate) fn consumed(fi: usize, e: usize) -> bool {
+    CONSUMED.with(|c| c.borrow().contains(&(fi, e)))
+}
+
+/// The edges that carry split points.
+pub(crate) fn split_edges() -> Vec<usize> {
+    SPLITS.with(|s| s.borrow().keys().copied().collect())
+}
+
+/// Adds the split point `p` to edge `e`; false when it is already there.
+pub(crate) fn split_add(e: usize, p: Point) -> bool {
+    SPLIT_ACTIVE.with(|c| c.set(true));
+    SPLITS.with(|s| {
+        let mut m = s.borrow_mut();
+        let list = m.entry(e).or_default();
+        if list.iter().any(|q| distance(*q, p) < 1e-9) {
+            return false;
+        }
+        list.push(p);
+        true
+    })
+}
+
+/// The raw UV samples of edge `e` on side `side`: its two ends and interior.
+fn edge_uv_raw(g: &ObjectGraph, e: usize, side: usize) -> Result<Vec<Uv>> {
+    let edge = &g.objects[e];
+    let ends = edge.fields["m_firstAndLastEdgePnts"]
+        .as_array()
+        .context("edge endpoints")?;
+    ensure!(ends.len() == 2, "edge endpoint count");
+    let uv = |v: &serde_json::Value| -> Result<Uv> {
+        let a = v.as_array().context("UV array")?;
+        ensure!(a.len() == 2, "UV dimension");
+        Ok([
+            a[0].as_f64().context("UV number")?,
+            a[1].as_f64().context("UV number")?,
+        ])
+    };
+    let mut points = vec![uv(&ends[0]["uv"][side])?];
+    for p in edge
+        .fields["m_interiorEdgePnts"]
+        .as_array()
+        .context("edge interior points")?
+    {
+        points.push(uv(&p["uv"][side])?);
+    }
+    points.push(uv(&ends[1]["uv"][side])?);
+    Ok(points)
+}
+
+/// Plans the 3D split of the boundary chord `ce` of face `fi`: a point on the
+/// shared trim edge that the chord crosses, found on both faces' surfaces.
+/// `None` when the chord's edge has no second trimmed face to match.
+pub(crate) fn plan_split(g: &ObjectGraph, fi: usize, ce: &ChordEdge) -> Result<Option<(usize, Point)>> {
+    let f = &g.objects[fi];
+    let si = pointer(g, fi, &f.fields["m_pSurf"])?.context("face surface")?;
+    let surf_i = ParametricSurface::read(g, si)?;
+    let mut found: Option<(usize, Uv, Uv)> = None;
+    let mut next = pointer(g, fi, &f.fields["m_pFirstLoop"])?;
+    let mut loops = BTreeSet::new();
+    while let Some(li) = next {
+        ensure!(loops.insert(li), "loop-list cycle");
+        let l = &g.objects[li];
+        let mut cur = pointer(g, li, &l.fields["m_next"])?.context("empty trim")?;
+        let mut guard = BTreeSet::new();
+        while cur != li {
+            ensure!(guard.insert(cur), "trim edge cycle");
+            let e = &g.objects[cur];
+            let faces = e.fields["m_pFace"].as_array().context("edge face pair")?;
+            let mut side = None;
+            for (i, p) in faces.iter().enumerate() {
+                if pointer(g, cur, p)? == Some(fi) {
+                    side = Some(i);
+                }
+            }
+            let side = side.context("edge does not belong to face")?;
+            if found.is_none() {
+                let points = edge_uv_raw(g, cur, side)?;
+                let points = apply_splits(cur, fi, &surf_i, points, false)?;
+                // Samples match by UV or by 3D position: a degenerate end of
+                // a ruled surface gives two UVs for one point.
+                let mut same = |x: Uv, y: Uv| -> Result<bool> {
+                    if (x[0] - y[0]).abs() < 1e-9 && (x[1] - y[1]).abs() < 1e-9 {
+                        return Ok(true);
+                    }
+                    Ok(distance(point3(&surf_i, x)?, point3(&surf_i, y)?) < 1e-7)
+                };
+                for k in 0..points.len().saturating_sub(1) {
+                    let forward = same(points[k], ce.a)? && same(points[k + 1], ce.b)?;
+                    let backward = same(points[k], ce.b)? && same(points[k + 1], ce.a)?;
+                    if forward || backward {
+                        found = Some((cur, points[k], points[k + 1]));
+                        break;
+                    }
+                }
+            }
+            cur = pointer(g, cur, &e.fields["m_next"][side])?.context("null trim next")?;
+        }
+        next = pointer(g, li, &l.fields["m_nextLoop"])?;
+    }
+    let Some((e, seg_a, seg_b)) = found else {
+        return Ok(None);
+    };
+    let faces = g.objects[e].fields["m_pFace"].as_array().context("edge face pair")?;
+    let mut other = None;
+    for p in faces {
+        if let Some(x) = pointer(g, e, p)? {
+            if x != fi {
+                other = Some(x);
+            }
+        }
+    }
+    let Some(fj) = other else {
+        return Ok(None);
+    };
+    let Some(sj_index) = pointer(g, fj, &g.objects[fj].fields["m_pSurf"])? else {
+        return Ok(None);
+    };
+    let mid = [(seg_a[0] + seg_b[0]) / 2., (seg_a[1] + seg_b[1]) / 2.];
+    // Under the retry rules a plane neighbour is met by projecting onto it;
+    // the plane's outline takes the split as a curved face's does (see
+    // `native_saved_mesh::refined_plane_edge`).
+    let p = if g.objects[sj_index].class_name == "Plane"
+        && crate::research::native_parametric_surface::new_rules()
+    {
+        let (origin, x, y) = plane_frame(g, sj_index)?;
+        let n = cross3(x, y);
+        let nn = dot3(n, n);
+        ensure!(nn > 1e-24, "singular plane");
+        edge_point(
+            &surf_i,
+            &|p: Point| {
+                let t = dot3(std::array::from_fn(|k| p[k] - origin[k]), n) / nn;
+                Ok(std::array::from_fn(|k| p[k] - t * n[k]))
+            },
+            mid,
+        )?
+    } else {
+        let Ok(surf_j) = ParametricSurface::read(g, sj_index) else {
+            return Ok(None);
+        };
+        edge_point(
+            &surf_i,
+            &|p: Point| {
+                let uv = nearest_uv(&surf_j, p)?;
+                surf_j.evaluate(uv[0], uv[1])
+            },
+            mid,
+        )?
+    };
+    let on_face = surf_i.evaluate(mid[0], mid[1])?;
+    // The split must sit at the chord, not elsewhere on the intersection.
+    if distance(p, on_face) > 0.05 {
+        return Ok(None);
+    }
+    Ok(Some((e, p)))
+}
+
+/// The trimmed mesh of a parametric face whose trim the rectangular grid
+/// cannot draw. It is refused unless its shared edges agree with their
+/// neighbours, as the curved-profile path requires.
+pub(crate) fn face(g: &ObjectGraph, fi: usize) -> Result<FaceMesh> {
+    let f = g.objects.get(fi).context("face index")?;
+    ensure!(f.class_name == "Face", "not Face");
+    ensure!(
+        f.fields["m_faceRegions"]
+            .as_array()
+            .is_some_and(Vec::is_empty),
+        "face regions need subdivision"
+    );
+    let si = pointer(g, fi, &f.fields["m_pSurf"])?.context("face surface")?;
+    let mut surface = ParametricSurface::read(g, si)?;
+    let ruled = matches!(surface, ParametricSurface::RuledSurf { .. });
+    // Under the retry rules a trimmed ruled face whose trim or shared-edge
+    // samples lie outside its saved envelope is widened to cover them, kept
+    // only where its shared edges then agree with their neighbours.
+    if ruled && crate::research::native_parametric_surface::new_rules() {
+        if let Some(wide) = widened_to_trim(g, fi, &surface)? {
+            let (e, u) = shared_edge_error(g, fi, &wide)?;
+            if u == 0 && e <= SHARED_EDGE_TOLERANCE {
+                surface = wide;
+            }
+        }
+    }
+    let (error, unverifiable) = shared_edge_error(g, fi, &surface)?;
+    ensure!(
+        unverifiable == 0,
+        "shared edge with an unverifiable neighbour"
+    );
+    if error > SHARED_EDGE_TOLERANCE {
+        if ruled {
+            bail!("trimmed ruled face: shared edge disagrees with its neighbour");
+        }
+        bail!("shared edge disagrees with its neighbour");
+    }
+
+    // Every loop of the face, the outer one first among the rest by area.
+    let mut rings = Vec::new();
+    let mut seen = BTreeSet::new();
+    let mut next = pointer(g, fi, &f.fields["m_pFirstLoop"])?;
+    while let Some(li) = next {
+        ensure!(seen.insert(li), "loop-list cycle");
+        rings.push(closed_ring(&surface, loop_segments(g, fi, li, &surface)?)?);
+        next = pointer(g, li, &g.objects[li].fields["m_nextLoop"])?;
+    }
+    ensure!(!rings.is_empty(), "face has no trim loop");
+    let islands = crate::research::native_parametric_surface::new_rules();
+    mesh_rings(g, fi, &surface, rings, islands)
+}
+
+/// The surface with its envelope widened to the UV extent of face `fi`'s
+/// trim loops and shared-edge samples, when that extent lies outside the
+/// saved envelope. `None` when the envelope already covers them.
+fn widened_to_trim(g: &ObjectGraph, fi: usize, surface: &ParametricSurface) -> Result<Option<ParametricSurface>> {
+    let f = g.objects.get(fi).context("face index")?;
+    let env = surface.bounds();
+    let mut lo = [f64::INFINITY; 2];
+    let mut hi = [f64::NEG_INFINITY; 2];
+    let mut seen = BTreeSet::new();
+    let mut next = pointer(g, fi, &f.fields["m_pFirstLoop"])?;
+    while let Some(li) = next {
+        ensure!(seen.insert(li), "loop-list cycle");
+        for seg in loop_segments(g, fi, li, surface)? {
+            for p in seg {
+                for k in 0..2 {
+                    lo[k] = lo[k].min(p[k]);
+                    hi[k] = hi[k].max(p[k]);
+                }
+            }
+        }
+        next = pointer(g, li, &g.objects[li].fields["m_nextLoop"])?;
+    }
+    shared_sample_extent(g, fi, &mut lo, &mut hi)?;
+    let outside = (0..2).any(|k| lo[k] < env[0][k] - 1e-7 || hi[k] > env[1][k] + 1e-7);
+    if !outside {
+        return Ok(None);
+    }
+    let wide = [
+        [lo[0].min(env[0][0]), lo[1].min(env[0][1])],
+        [hi[0].max(env[1][0]), hi[1].max(env[1][1])],
+    ];
+    Ok(Some(surface.with_envelope(wide)))
+}
+
+/// Widens `lo`/`hi` to the UV samples of the edges that face `fi` shares
+/// with a neighbour: the samples `shared_edge_error` checks.
+fn shared_sample_extent(g: &ObjectGraph, fi: usize, lo: &mut [f64; 2], hi: &mut [f64; 2]) -> Result<()> {
+    for (ei, edge) in g.objects.iter().enumerate().filter(|(_, o)| o.class_name == "Edge") {
+        let Some(faces) = edge.fields.get("m_pFace").and_then(|v| v.as_array()) else {
+            continue;
+        };
+        if faces.len() != 2 {
+            continue;
+        }
+        let resolved = [
+            pointer(g, ei, &faces[0]).ok().flatten(),
+            pointer(g, ei, &faces[1]).ok().flatten(),
+        ];
+        let side = match resolved {
+            [Some(a), Some(b)] if a == fi && b != fi => 0,
+            [Some(a), Some(b)] if b == fi && a != fi => 1,
+            _ => continue,
+        };
+        let ends = edge.fields["m_firstAndLastEdgePnts"]
+            .as_array()
+            .context("edge endpoints")?;
+        let interior = edge.fields["m_interiorEdgePnts"]
+            .as_array()
+            .context("edge interior samples")?;
+        let mut samples: Vec<&serde_json::Value> = vec![&ends[0]];
+        samples.extend(interior.iter());
+        samples.push(&ends[1]);
+        for sample in samples {
+            let uv = sample["uv"][side].as_array().context("UV array")?;
+            for k in 0..2 {
+                let x = uv[k].as_f64().context("UV number")?;
+                lo[k] = lo[k].min(x);
+                hi[k] = hi[k].max(x);
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Whether a CDT refusal sends a trimmed ruled face to `ruled_grid_mesh`
+/// (under the retry rules): the budget and refinement refusals, not a
+/// chord-split request.
+fn ruled_grid_fallback(e: &anyhow::Error, surface: &ParametricSurface) -> bool {
+    crate::research::native_parametric_surface::new_rules()
+        && matches!(surface, ParametricSurface::RuledSurf { .. })
+        && e.downcast_ref::<ChordEdge>().is_none()
+        && (is_budget(e)
+            || e.to_string().contains("needs too many refinement points")
+            || e.to_string().contains("needs a finer triangulation"))
+}
+
+/// Mesh of a trimmed RuledSurf that the CDT refuses (retry rules only). A
+/// grid over the surface's envelope, n steps along from `ruled_segments` and
+/// rows across from `ruled_band`, adds its nodes inside the trim to the trim's
+/// samples, each at least half a grid step from the trim; the constrained
+/// Delaunay triangulation, taken at the band's model lengths, is cut by the
+/// trim. No refinement: every triangle must meet DISPLAY_TOLERANCE.
+fn ruled_grid_mesh(
+    surface: &ParametricSurface,
+    rings: &[Vec<Uv>],
+    boundary: &[Uv],
+    boundary_edges: &BTreeSet<(u32, u32)>,
+    boundary_count: usize,
+    expected: f64,
+) -> Result<(Vec<Uv>, Vec<[u32; 3]>)> {
+    let ParametricSurface::RuledSurf { profile1, profile2, .. } = surface else {
+        bail!("not a ruled surface")
+    };
+    let n = ruled_segments(profile1, profile2)?.ceil();
+    ensure!(n.is_finite() && n >= 1., "ruled grid divisions");
+    // Steps along follow the profiles; rows across the straight rulings
+    // follow the band's twist and shape (see `ruled_band`).
+    let env = surface.bounds();
+    let (u, v) = ([env[0][0], env[1][0]], [env[0][1], env[1][1]]);
+    let band = ruled_band(surface, u, v, n)?;
+    let columns = ((u[1] - u[0]) * n).ceil().max(1.) as usize;
+    let rows = band.rows as usize;
+    ensure!((columns + 1) * (rows + 1) <= MAX_VERTICES, "ruled grid exceeds its budget");
+    let (du, dv) = ((u[1] - u[0]) / columns as f64, (v[1] - v[0]) / rows as f64);
+    // Distances in grid steps, so a node keeps half a step from the trim
+    // along both directions.
+    let steps = |p: Uv| -> Uv { [(p[0] - u[0]) / du, (p[1] - v[0]) / dv] };
+    let constraints: Vec<(u32, u32)> = boundary_edges.iter().copied().collect();
+    let mut points = boundary.to_vec();
+    for i in 0..=columns {
+        for j in 0..=rows {
+            let p = [u[0] + i as f64 * du, v[0] + j as f64 * dv];
+            if !in_region(p, rings) {
+                continue;
+            }
+            let near = constraints.iter().any(|&(a, b)| {
+                segment_distance(steps(p), steps(boundary[a as usize]), steps(boundary[b as usize])) < 0.5
+            });
+            if !near {
+                points.push(p);
+            }
+        }
+    }
+    ensure!(points.len() < MAX_VERTICES, "ruled grid exceeds its budget");
+    // Triangulated at the band's model lengths, so its triangles are not
+    // stretched along the long side of a narrow band.
+    let scaled: Vec<Uv> = points
+        .iter()
+        .map(|p| [p[0] * band.scale[0], p[1] * band.scale[1]])
+        .collect();
+    let mut tris = delaunay(&scaled);
+    constrain(&scaled, &mut tris, &constraints)?;
+    tris.retain(|t| in_region(centroid(&points, *t), rings));
+    ensure!(tris.len() < MAX_TRIANGLES, "ruled grid exceeds its budget");
+    let sum: f64 = tris
+        .iter()
+        .map(|t| cross2(points[t[0] as usize], points[t[1] as usize], points[t[2] as usize]).abs() * 0.5)
+        .sum();
+    ensure!(
+        (sum - expected).abs() <= 1e-7 * expected.max(1e-6),
+        "triangulated area mismatch"
+    );
+    // No refinement follows, so a triangle along the trim spans a whole cell
+    // (across a narrow band, its full width) and cannot be finer than the
+    // display tolerance: every triangle is held to it.
+    let bad = bad_triangles(surface, &points, &tris, boundary_count, DISPLAY_TOLERANCE, DISPLAY_TOLERANCE)?;
+    ensure!(bad.is_empty(), "ruled grid does not meet the surface");
+    Ok((points, tris))
+}
+
+/// The trimmed mesh of face `fi` on `surface`, given its trim rings in UV.
+/// The outer ring is the one of largest area; the others are holes.
+pub(crate) fn mesh_rings(
+    g: &ObjectGraph,
+    fi: usize,
+    surface: &ParametricSurface,
+    rings: Vec<Vec<Uv>>,
+    islands: bool,
+) -> Result<FaceMesh> {
+    let f = g.objects.get(fi).context("face index")?;
+    let ring_set = rings.clone();
+    let outer_index = (0..rings.len())
+        .max_by(|&a, &b| signed_area(&rings[a]).abs().total_cmp(&signed_area(&rings[b]).abs()))
+        .context("no trim ring")?;
+    let outer = rings[outer_index].clone();
+    let holes: Vec<Vec<Uv>> = rings
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| *i != outer_index)
+        .map(|(_, r)| r.clone())
+        .collect();
+    let mut expected = signed_area(&outer).abs();
+    for (i, h) in holes.iter().enumerate() {
+        // Under `islands` (a cylinder face whose rings do not nest) a ring
+        // outside the outer one is a separate piece of the face, not a hole.
+        if islands && !inside(h[0], &outer) {
+            ensure!(
+                holes
+                    .iter()
+                    .enumerate()
+                    .all(|(j, other)| i == j || !inside(h[0], other)),
+                "nested trim islands unsupported"
+            );
+            expected += signed_area(h).abs();
+            continue;
+        }
+        ensure!(inside(h[0], &outer), "trim hole outside its outer loop");
+        ensure!(
+            holes
+                .iter()
+                .enumerate()
+                .all(|(j, other)| i == j || !inside(h[0], other)),
+            "nested trim holes unsupported"
+        );
+        expected -= signed_area(h).abs();
+    }
+    ensure!(expected > 1e-12, "degenerate parametric trim area");
+
+    // Triangulate the boundary samples with their holes.
+    let mut uv: Vec<Uv> = outer.clone();
+    let mut hole_starts = Vec::new();
+    for h in &holes {
+        hole_starts.push(uv.len() as u32);
+        uv.extend_from_slice(h);
+    }
+    let mut boundary_edges = BTreeSet::new();
+    let mut add_ring = |start: usize, len: usize| {
+        for k in 0..len {
+            let a = (start + k) as u32;
+            let b = (start + (k + 1) % len) as u32;
+            boundary_edges.insert((a.min(b), a.max(b)));
+        }
+    };
+    add_ring(0, outer.len());
+    for (h, &start) in holes.iter().zip(&hole_starts) {
+        add_ring(start as usize, h.len());
+    }
+    let rings: Vec<&[Uv]> = std::iter::once(outer.as_slice())
+        .chain(holes.iter().map(Vec::as_slice))
+        .collect();
+    let boundary_tol = boundary_tolerance(&surface, &rings)?;
+    let boundary_count = uv.len();
+    // A single-loop trim is first meshed by the interior lattice, as before.
+    // A face with holes, or one the lattice refuses, is meshed by the CDT.
+    let lattice = if holes.is_empty() {
+        lattice_mesh(
+            &uv,
+            &hole_starts,
+            &outer,
+            &holes,
+            &surface,
+            boundary_count,
+            boundary_tol,
+            expected,
+        )?
+    } else {
+        None
+    };
+    let (uv, done) = match lattice {
+        Some(found) => found,
+        None => match cdt_mesh(
+            &surface,
+            &ring_set,
+            &uv,
+            &boundary_edges,
+            boundary_count,
+            boundary_tol,
+            expected,
+        ) {
+            Ok(found) => found,
+            Err(e) if ruled_grid_fallback(&e, surface) => ruled_grid_mesh(
+                surface,
+                &ring_set,
+                &uv,
+                &boundary_edges,
+                boundary_count,
+                expected,
+            )
+            .map_err(|_| e)?,
+            Err(e) => return Err(e),
+        },
+    };
+    let verts3: Vec<[f64; 3]> = uv.iter().map(|&p| point3(&surface, p)).collect::<Result<_>>()?;
+    {
+        // The boundary is still the samples' own: each boundary edge is used
+        // once, each interior edge twice.
+        let mut uses: BTreeMap<(u32, u32), u32> = BTreeMap::new();
+        for t in &done {
+            for (a, b) in [(t[0], t[1]), (t[1], t[2]), (t[2], t[0])] {
+                *uses.entry((a.min(b), a.max(b))).or_default() += 1;
+            }
+        }
+        for (edge, count) in &uses {
+            ensure!(
+                if boundary_edges.contains(edge) { *count == 1 } else { *count == 2 },
+                "trim triangulation is not a manifold"
+            );
+        }
+        ensure!(
+            boundary_edges.iter().all(|e| uses.contains_key(e)),
+            "trim boundary not covered"
+        );
+    }
+
+    // Normals and winding follow the grid's rule (tessellate_uv): the
+    // surface's own orientation against the face's flag.
+    let flags = f.fields["m_faceFlags_v9"].as_u64().context("face flags")?;
+    let orient = flags & 2 == 0;
+    let winding = surface.orientation() == orient;
+    let area3 = |x: u32, y: u32, z: u32| {
+        let p = verts3[x as usize];
+        let q = verts3[y as usize];
+        let r = verts3[z as usize];
+        let u = [q[0] - p[0], q[1] - p[1], q[2] - p[2]];
+        let v = [r[0] - p[0], r[1] - p[1], r[2] - p[2]];
+        (u[1] * v[2] - u[2] * v[1])
+            .hypot((u[2] * v[0] - u[0] * v[2]).hypot(u[0] * v[1] - u[1] * v[0]))
+    };
+    let collapsed = |x: u32, y: u32| {
+        let p = verts3[x as usize];
+        let q = verts3[y as usize];
+        (0..3).map(|k| (q[k] - p[k]).powi(2)).sum::<f64>() <= 1e-20
+    };
+    let mut remap = vec![u32::MAX; verts3.len()];
+    let mut vertices = Vec::new();
+    let mut normals = Vec::new();
+    let mut triangles = Vec::new();
+    for t in &done {
+        let [a, b, c] = *t;
+        let (pa, pb, pc) = (uv[a as usize], uv[b as usize], uv[c as usize]);
+        // The triangle is counter-clockwise in UV, as the grid's are.
+        let ccw = cross2(pa, pb, pc) > 0.;
+        let (x, y, z) = if ccw { (a, b, c) } else { (a, c, b) };
+        if area3(x, y, z) <= 1e-12 {
+            ensure!(
+                collapsed(x, y) || collapsed(y, z) || collapsed(z, x),
+                "noncollapsed degenerate parametric triangle"
+            );
+            continue;
+        }
+        let mut out = [0u32; 3];
+        for (slot, &vi) in [x, y, z].iter().enumerate() {
+            if remap[vi as usize] == u32::MAX {
+                let p = uv[vi as usize];
+                remap[vi as usize] = vertices.len() as u32;
+                vertices.push(verts3[vi as usize]);
+                let mut n = surface.normal(p[0], p[1])?;
+                if !orient {
+                    for value in &mut n {
+                        *value = -*value;
+                    }
+                }
+                normals.push(n);
+            }
+            out[slot] = remap[vi as usize];
+        }
+        triangles.push(if winding { out } else { [out[0], out[2], out[1]] });
+    }
+    ensure!(!triangles.is_empty(), "trimmed parametric face produced no triangles");
+    let normal = normals[0];
+    Ok(FaceMesh {
+        face_index: fi,
+        face_tag: f.fields["m_GInfo"]["m_tag"].as_i64().unwrap_or(-1),
+        render_style_id: crate::native_metadata::identifier(&f.fields["m_renderStyleId"])?,
+        normal,
+        vertices,
+        normals,
+        triangles,
+        analytic_surface: None,
+        trim_uv: outer,
+    })
+}
+
