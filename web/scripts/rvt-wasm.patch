+    /// Every edge of the mesh bounds two triangles once coincident vertices
+    /// are merged.
+    fn watertight((vertices, triangles): &RailMesh) -> bool {
+        let key = |v: [f64; 3]| v.map(|c| (c * 1e6).round() as i64);
+        let mut edges = std::collections::HashMap::new();
+        for t in triangles {
+            for (a, b) in [(t[0], t[1]), (t[1], t[2]), (t[2], t[0])] {
+                let (a, b) = (key(vertices[a as usize]), key(vertices[b as usize]));
+                *edges.entry(if a < b { (a, b) } else { (b, a) }).or_insert(0) += 1;
+            }
+        }
+        edges.values().all(|&n| n == 2)
+    }
