+/// The box of an open edge, grown by `margin` on every side.
+fn bounds_grown(e: &OpenEdge, margin: f64) -> ([f64; 3], [f64; 3]) {
+    (
+        std::array::from_fn(|k| e.a[k].min(e.b[k]) - margin),
+        std::array::from_fn(|k| e.a[k].max(e.b[k]) + margin),
+    )
+}
+
+/// Whether the points lie within 0.05 ft of one plane parallel to an axis.
+fn within_one_plane(points: &[[f64; 3]]) -> bool {
+    (0..3).any(|axis| {
+        let lo = points.iter().map(|m| m[axis]).fold(f64::INFINITY, f64::min);
+        let hi = points
+            .iter()
+            .map(|m| m[axis])
+            .fold(f64::NEG_INFINITY, f64::max);
+        hi - lo <= 0.05
+    })
+}
+
+/// The union-find root of `i`, halving the path as it goes.
+fn find(parent: &mut [usize], mut i: usize) -> usize {
+    while parent[i] != i {
+        parent[i] = parent[parent[i]];
+        i = parent[i];
+    }
+    i
+}
+
+/// The distance from `p` to the segment `a`-`b` in 3D.
+fn segment_distance3(p: [f64; 3], a: [f64; 3], b: [f64; 3]) -> f64 {
+    let d: [f64; 3] = std::array::from_fn(|k| b[k] - a[k]);
+    let len2: f64 = d.iter().map(|x| x * x).sum();
+    let t = if len2 > 0. {
+        ((0..3).map(|k| (p[k] - a[k]) * d[k]).sum::<f64>() / len2).clamp(0., 1.)
+    } else {
+        0.
+    };
+    distance(p, std::array::from_fn(|k| a[k] + t * d[k]))
+}
