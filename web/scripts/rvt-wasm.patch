+/// The cubic Hermite basis on [0, 1] at `s`: the value weights of the left and
+/// right ends, the tangent weights of the left and right ends, and the
+/// derivatives of each.
+fn hermite_weights(s: f64) -> ([f64; 2], [f64; 2], [f64; 2], [f64; 2]) {
+    let (s2, s3) = (s * s, s * s * s);
+    (
+        [2. * s3 - 3. * s2 + 1., -2. * s3 + 3. * s2],
+        [s3 - 2. * s2 + s, s3 - s2],
+        [6. * s2 - 6. * s, -6. * s2 + 6. * s],
+        [3. * s2 - 4. * s + 1., 3. * s2 - 2. * s],
+    )
